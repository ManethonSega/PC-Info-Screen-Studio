<UserControl x:Class="PCInfoScreenStudio.Controls.ColorPickerButton"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Button Click="OnClick" Padding="6,4" HorizontalContentAlignment="Stretch">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="28" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border x:Name="Swatch" Width="22" Height="22" CornerRadius="3" BorderBrush="#55606E" BorderThickness="1" />
      <TextBlock Grid.Column="1" Text="{Binding HexColor, ElementName=Root}" VerticalAlignment="Center" Margin="8,0,0,0" />
    </Grid>
  </Button>
</UserControl>
