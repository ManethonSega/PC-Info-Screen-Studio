<UserControl x:Class="PCInfoScreenStudio.Controls.DesignerSurface"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PCInfoScreenStudio.Controls"
             xmlns:models="clr-namespace:PCInfoScreenStudio.Models"
             Background="Transparent">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </UserControl.Resources>

  <Grid ClipToBounds="True">
  <ScrollViewer x:Name="CanvasScrollViewer" SizeChanged="OnViewportSizeChanged" HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto"
                CanContentScroll="False">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
      <Border x:Name="CanvasFrame" BorderBrush="{StaticResource StrongBorderBrush}"
              BorderThickness="1"
              Background="{StaticResource CanvasWellBrush}">
        <Border.LayoutTransform>
          <ScaleTransform ScaleX="{Binding CanvasViewScale}" ScaleY="{Binding CanvasViewScale}" />
        </Border.LayoutTransform>

        <Grid x:Name="EditorCanvas"
              Width="{Binding Document.CanvasWidth}"
              Height="{Binding Document.CanvasHeight}"
              Background="Transparent"
              PreviewMouseLeftButtonDown="OnCanvasMouseDown"
              PreviewMouseMove="OnCanvasMouseMove"
              PreviewMouseLeftButtonUp="OnCanvasMouseUp">
          <Image x:Name="RenderSurface"
                 Stretch="Fill"
                 IsHitTestVisible="False"
                 SnapsToDevicePixels="True" />

          <Canvas x:Name="GridOverlay"
                  Width="{Binding Document.CanvasWidth}"
                  Height="{Binding Document.CanvasHeight}"
                  IsHitTestVisible="False" />

          <ItemsControl ItemsSource="{Binding Document.EditorWidgets}">
            <ItemsControl.Style>
              <Style TargetType="ItemsControl">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Document.Mode}" Value="{x:Static models:ScreenMode.PhotoFrame}">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsLiveMode}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ItemsControl.Style>
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <Canvas Background="Transparent" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
              <Style TargetType="ContentPresenter">
                <Setter Property="Canvas.Left" Value="{Binding X}" />
                <Setter Property="Canvas.Top" Value="{Binding Y}" />
                <Setter Property="Panel.ZIndex" Value="{Binding ZIndex}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Panel.ZIndex" Value="5000" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <local:DesignerItemControl Width="{Binding Width}"
                                           Height="{Binding Height}"
                                           Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Canvas Panel.ZIndex="9999" IsHitTestVisible="False">
            <Rectangle x:Name="SelectionMarquee"
                       Fill="{StaticResource SelectionFillBrush}"
                       Stroke="{StaticResource AccentBrush}"
                       StrokeThickness="1"
                       StrokeDashArray="3,2"
                       Visibility="Collapsed" />
          </Canvas>

          <Canvas x:Name="AlignmentGuideOverlay"
                  Width="{Binding Document.CanvasWidth}"
                  Height="{Binding Document.CanvasHeight}"
                  Panel.ZIndex="10000"
                  IsHitTestVisible="False">
            <Line x:Name="VerticalGuide" Stroke="{StaticResource AquaBrush}" StrokeThickness="1" Visibility="Collapsed" />
            <Line x:Name="HorizontalGuide" Stroke="{StaticResource AquaBrush}" StrokeThickness="1" Visibility="Collapsed" />
          </Canvas>
        </Grid>
      </Border>
    </Grid>
  </ScrollViewer>
          <!-- Viewport instructions remain readable at every canvas zoom; never sent to USB. -->
          <Border Panel.ZIndex="9000" HorizontalAlignment="Center" VerticalAlignment="Center"
                  MaxWidth="360" Margin="16" IsHitTestVisible="False"
                  Background="{StaticResource PanelBrush}" CornerRadius="8">
          <StackPanel>
            <Border x:Name="PhotoEmptyState" Background="{StaticResource EmptyStateBrush}" CornerRadius="6" Padding="18" Margin="0,4">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <MultiDataTrigger>
                      <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Document.Mode}" Value="{x:Static models:ScreenMode.PhotoFrame}" />
                        <Condition Binding="{Binding Document.PhotoFrame.Photos.Count}" Value="0" />
                        <Condition Binding="{Binding IsLiveMode}" Value="False" />
                      </MultiDataTrigger.Conditions>
                      <Setter Property="Visibility" Value="Visible" />
                    </MultiDataTrigger>
                    <MultiDataTrigger>
                      <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Document.Mode}" Value="{x:Static models:ScreenMode.Hybrid}" />
                        <Condition Binding="{Binding Document.PhotoFrame.Photos.Count}" Value="0" />
                        <Condition Binding="{Binding IsLiveMode}" Value="False" />
                      </MultiDataTrigger.Conditions>
                      <Setter Property="Visibility" Value="Visible" />
                    </MultiDataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <StackPanel>
                <TextBlock Text="Add photos or choose a folder" FontSize="17" FontWeight="SemiBold"
                           TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock Text="Use Add files or Add folder on the left." Foreground="{StaticResource MutedTextBrush}"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" />
              </StackPanel>
            </Border>
            <Border x:Name="HybridEmptyState" Background="{StaticResource EmptyStateBrush}" CornerRadius="6" Padding="18" Margin="0,4">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <MultiDataTrigger>
                      <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Document.Mode}" Value="{x:Static models:ScreenMode.Hybrid}" />
                        <Condition Binding="{Binding Document.HybridWidgets.Count}" Value="0" />
                        <Condition Binding="{Binding IsLiveMode}" Value="False" />
                      </MultiDataTrigger.Conditions>
                      <Setter Property="Visibility" Value="Visible" />
                    </MultiDataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <StackPanel>
                <TextBlock Text="Add an overlay" FontSize="17" FontWeight="SemiBold" TextAlignment="Center" />
                <TextBlock Text="Choose an item under Hybrid overlays on the left." Foreground="{StaticResource MutedTextBrush}"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
          </Border>

  </Grid>
</UserControl>

