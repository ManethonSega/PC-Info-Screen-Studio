<UserControl x:Class="PCInfoScreenStudio.Controls.DesignerSurface"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PCInfoScreenStudio.Controls"
             xmlns:models="clr-namespace:PCInfoScreenStudio.Models"
             Background="Transparent">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </UserControl.Resources>

  <ScrollViewer HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto"
                CanContentScroll="False">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
      <Border BorderBrush="#444B58"
              BorderThickness="1"
              Background="#050608"
              Width="{Binding Document.CanvasWidth}"
              Height="{Binding Document.CanvasHeight}">
        <Border.LayoutTransform>
          <ScaleTransform ScaleX="{Binding CanvasZoom}" ScaleY="{Binding CanvasZoom}" />
        </Border.LayoutTransform>

        <Grid x:Name="EditorCanvas"
              Width="{Binding Document.CanvasWidth}"
              Height="{Binding Document.CanvasHeight}"
              Background="Transparent"
              PreviewMouseLeftButtonDown="OnCanvasMouseDown"
              PreviewMouseMove="OnCanvasMouseMove"
              PreviewMouseLeftButtonUp="OnCanvasMouseUp">
          <Image x:Name="RenderSurface"
                 Stretch="Fill"
                 IsHitTestVisible="False"
                 SnapsToDevicePixels="True" />

          <Canvas x:Name="GridOverlay"
                  Width="{Binding Document.CanvasWidth}"
                  Height="{Binding Document.CanvasHeight}"
                  IsHitTestVisible="False" />

          <ItemsControl ItemsSource="{Binding Document.EditorWidgets}">
            <ItemsControl.Style>
              <Style TargetType="ItemsControl">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Document.Mode}" Value="{x:Static models:ScreenMode.PhotoFrame}">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ItemsControl.Style>
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <Canvas Background="Transparent" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
              <Style TargetType="ContentPresenter">
                <Setter Property="Canvas.Left" Value="{Binding X}" />
                <Setter Property="Canvas.Top" Value="{Binding Y}" />
                <Setter Property="Panel.ZIndex" Value="{Binding ZIndex}" />
              </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <local:DesignerItemControl Width="{Binding Width}"
                                           Height="{Binding Height}"
                                           Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Canvas Panel.ZIndex="9999" IsHitTestVisible="False">
            <Rectangle x:Name="SelectionMarquee"
                       Fill="#285B8CFF"
                       Stroke="#FF5B8CFF"
                       StrokeThickness="1"
                       StrokeDashArray="3,2"
                       Visibility="Collapsed" />
          </Canvas>

          <Canvas x:Name="AlignmentGuideOverlay"
                  Width="{Binding Document.CanvasWidth}"
                  Height="{Binding Document.CanvasHeight}"
                  Panel.ZIndex="10000"
                  IsHitTestVisible="False">
            <Line x:Name="VerticalGuide" Stroke="#FFFF4F79" StrokeThickness="1" Visibility="Collapsed" />
            <Line x:Name="HorizontalGuide" Stroke="#FFFF4F79" StrokeThickness="1" Visibility="Collapsed" />
          </Canvas>
        </Grid>
      </Border>
    </Grid>
  </ScrollViewer>
</UserControl>
