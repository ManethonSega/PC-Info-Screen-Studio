<UserControl x:Class="PCInfoScreenStudio.Controls.DesignerItemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="Transparent"
             Focusable="True"
             PreviewMouseLeftButtonDown="OnSelect"
             PreviewKeyDown="OnKeyDown">
  <UserControl.Resources>
    <Style x:Key="TransparentMoveThumb" TargetType="Thumb">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="SizeAll" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border Background="Transparent" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ResizeThumb" TargetType="Thumb">
      <Setter Property="Width" Value="9" />
      <Setter Property="Height" Value="9" />
      <Setter Property="Background" Value="#FFF5F7FA" />
      <Setter Property="BorderBrush" Value="#FF3377FF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Visibility" Value="Collapsed" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <EventSetter Event="DragStarted" Handler="OnResizeStarted" />
      <EventSetter Event="DragDelta" Handler="OnResize" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsLocked}" Value="True">
          <Setter Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Border x:Name="SelectionBorder"
            BorderThickness="1"
            Background="Transparent"
            IsHitTestVisible="False">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="BorderBrush" Value="Transparent" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
              <Setter Property="BorderBrush" Value="#FF5B8CFF" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
    </Border>

    <Thumb x:Name="MoveThumb"
           Style="{StaticResource TransparentMoveThumb}"
           DragDelta="OnMove"
           DragStarted="OnDragStarted"
           DragCompleted="OnDragCompleted" />

    <Thumb Style="{StaticResource ResizeThumb}" Tag="NW" Cursor="SizeNWSE" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-4,-4,0,0" />
    <Thumb Style="{StaticResource ResizeThumb}" Tag="N" Cursor="SizeNS" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-4,0,0" />
    <Thumb Style="{StaticResource ResizeThumb}" Tag="NE" Cursor="SizeNESW" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0" />
    <Thumb Style="{StaticResource ResizeThumb}" Tag="E" Cursor="SizeWE" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-4,0" />
    <Thumb Style="{StaticResource ResizeThumb}" Tag="SE" Cursor="SizeNWSE" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-4" />
    <Thumb Style="{StaticResource ResizeThumb}" Tag="S" Cursor="SizeNS" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-4" />
    <Thumb Style="{StaticResource ResizeThumb}" Tag="SW" Cursor="SizeNESW" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-4,0,0,-4" />
    <Thumb Style="{StaticResource ResizeThumb}" Tag="W" Cursor="SizeWE" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-4,0,0,0" />
  </Grid>
</UserControl>
