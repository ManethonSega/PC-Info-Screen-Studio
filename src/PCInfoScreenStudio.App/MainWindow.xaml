<Window x:Class="PCInfoScreenStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PCInfoScreenStudio.Controls"
        xmlns:models="clr-namespace:PCInfoScreenStudio.Models"
        Style="{StaticResource {x:Type Window}}"
        Title="{Binding WindowTitle}"
        Icon="{StaticResource AppIconImage}"
        Width="1560" Height="1080" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded"
        Closing="OnClosing" StateChanged="OnWindowStateChanged" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
  <Window.Resources>
    <Style x:Key="AlignmentButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="28" /><Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="4" />
    </Style>
  </Window.Resources>
  <Window.InputBindings>
    <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand}" />
    <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}" />
    <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
    <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsCommand}" />
    <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
    <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
    <KeyBinding Key="Delete" Command="{Binding DeleteWidgetCommand}" />
    <KeyBinding Key="D" Modifiers="Control" Command="{Binding DuplicateWidgetCommand}" />
    <KeyBinding Key="G" Modifiers="Control" Command="{Binding GroupSelectedCommand}" />
    <KeyBinding Key="G" Modifiers="Control+Shift" Command="{Binding UngroupSelectedCommand}" />
  </Window.InputBindings>

  <Grid Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="30" />
    </Grid.RowDefinitions>

    <!-- Top toolbar -->
    <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
      <WrapPanel Margin="12,8">
        <StackPanel Orientation="Horizontal">
          <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="2" Margin="0,0,12,0">
            <StackPanel Orientation="Horizontal">
              <Button Content="Editor" Command="{Binding ShowEditorPageCommand}" Padding="16,5" ToolTip="Return to your current theme and canvas.">
                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
                  <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
                  <Style.Triggers><DataTrigger Binding="{Binding IsEditorPage}" Value="True"><Setter Property="Background" Value="{StaticResource SelectedBrush}" /><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers>
                </Style></Button.Style>
              </Button>
              <Button Content="Hardware" Command="{Binding ShowHardwarePageCommand}" Padding="16,5" ToolTip="View your PC hardware names and live sensor readings.">
                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
                  <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
                  <Style.Triggers><DataTrigger Binding="{Binding IsHardwarePage}" Value="True"><Setter Property="Background" Value="{StaticResource SelectedBrush}" /><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers>
                </Style></Button.Style>
              </Button>
            </StackPanel>
          </Border>
          <Button Visibility="{Binding EditorPageVisibility}" Command="{Binding UndoCommand}" Style="{StaticResource ToolbarButtonStyle}" AutomationProperties.Name="Undo" AutomationProperties.AcceleratorKey="Ctrl+Z" ToolTip="Undo the last edit (Ctrl+Z)."><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7A7;" Style="{StaticResource ToolbarIconStyle}" /><TextBlock Text="Undo" /></StackPanel></Button>
          <Button Visibility="{Binding EditorPageVisibility}" Command="{Binding RedoCommand}" Style="{StaticResource ToolbarButtonStyle}" AutomationProperties.Name="Redo" AutomationProperties.AcceleratorKey="Ctrl+Y" ToolTip="Reapply an undone edit (Ctrl+Y)."><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7A6;" Style="{StaticResource ToolbarIconStyle}" /><TextBlock Text="Redo" /></StackPanel></Button>
          <Button Click="OnSettingsClick" Style="{StaticResource ToolbarButtonStyle}" AutomationProperties.Name="Settings" ToolTip="Open connection, Windows startup, runtime, sensor access and editor preferences."><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource ToolbarIconStyle}" /><TextBlock Text="Settings" /></StackPanel></Button>
          <Button Visibility="{Binding EditorPageVisibility}" Command="{Binding ToggleEditorModeCommand}" Style="{StaticResource ToolbarButtonStyle}" AutomationProperties.Name="{Binding EditorModeLabel}" ToolTip="Switch between editing controls and a clean preview; display output continues."><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding EditorModeIcon}" Style="{StaticResource ToolbarIconStyle}" /><TextBlock Text="{Binding EditorModeLabel}" /></StackPanel></Button>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="8,3,0,3">
          <TextBlock Text="Screen" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
          <ComboBox AutomationProperties.Name="Physical screen model" x:Name="ScreenSelector" Width="196" Height="32" Margin="0,0,8,0"
                    ItemsSource="{Binding CanvasSizes}" DisplayMemberPath="Label" SelectedValuePath="Value"
                    SelectedValue="{Binding CanvasSize, Mode=TwoWay}" IsEnabled="{Binding CanChooseScreen}"
                    ToolTip="Choose the physical screen. The canvas and loaded themes resize automatically; reconnect stays on this screen." />
          <Border Padding="0" Margin="0,0,12,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Mode" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource PageTextBrush}" />
              <ComboBox AutomationProperties.Name="Screen mode" Width="170" Height="32"
                        Background="{StaticResource InputBrush}"
                        Foreground="{StaticResource PageTextBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        FontSize="13" FontWeight="SemiBold"
                        ItemsSource="{Binding ScreenModes}"
                        DisplayMemberPath="Label"
                        SelectedValuePath="Value"
                        SelectedValue="{Binding Document.Mode}" IsEnabled="{Binding CanChangeWorkspace}"
                        ToolTip="Switch the complete workspace between Info Screen, Photo Frame, and Hybrid." />
            </StackPanel>
          </Border>
          <Grid VerticalAlignment="Center" Margin="0,0,8,0">
            <Button x:Name="BrightnessButton" Click="OnBrightnessClick" Padding="10,6"
                    IsEnabled="{Binding CanChooseScreen}" AutomationProperties.Name="Display brightness"
                    ToolTip="Adjust the selected screen's brightness. Each screen family keeps its own level; disconnected changes apply on next connection.">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE706;" Style="{StaticResource ToolbarIconStyle}" /><TextBlock Text="{Binding BrightnessLabel}" /></StackPanel>
            </Button>
            <Popup x:Name="BrightnessPopup" PlacementTarget="{Binding ElementName=BrightnessButton}" Placement="Bottom"
                   StaysOpen="False" AllowsTransparency="True" Opened="OnBrightnessOpened" Closed="OnBrightnessClosed">
              <Border Width="270" Padding="16" Margin="0,5,0,0" CornerRadius="8"
                      Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrongBorderBrush}" BorderThickness="1"
                      DataContext="{Binding PlacementTarget.DataContext, ElementName=BrightnessPopup}" PreviewKeyDown="OnBrightnessKeyDown">
                <StackPanel>
                  <DockPanel><TextBlock Text="Screen brightness" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" /><TextBlock Text="{Binding DisplayBrightness, StringFormat={}{0}%}" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}" /></DockPanel>
                  <Slider x:Name="BrightnessSlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                          SmallChange="1" LargeChange="10" Value="{Binding DisplayBrightness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                          IsEnabled="{Binding CanChooseScreen}"
                          AutomationProperties.Name="Screen brightness percentage" ToolTip="0% dims the physical screen completely. Arrow keys adjust by 1%." />
                  <DockPanel><TextBlock Text="Dim" Foreground="{StaticResource MutedTextBrush}" /><TextBlock Text="Bright" HorizontalAlignment="Right" Foreground="{StaticResource MutedTextBrush}" /></DockPanel>
                  <Button x:Name="ResetBrightnessButton" Content="Reset to 50%" Command="{Binding ResetBrightnessCommand}" IsEnabled="{Binding CanChooseScreen}" HorizontalAlignment="Left" Margin="0,10,0,0" Style="{StaticResource QuietButtonStyle}" />
                </StackPanel>
              </Border>
            </Popup>
          </Grid>
          <Button Content="{Binding DisplayActionLabel}"
                  Command="{Binding ConnectCommand}"
                  Style="{StaticResource PrimaryButtonStyle}"
                  Padding="18,6"
                  ToolTip="{Binding DisplayActionToolTip}" />
        </StackPanel>
      </WrapPanel>
    </Border>

    <!-- Docked workspace; only the centre takes remaining width. -->
    <Grid x:Name="EditorWorkspace" Grid.Row="1" Visibility="{Binding EditorPageVisibility}" IsEnabled="{Binding CanEditContent}" SizeChanged="OnWorkspaceSizeChanged">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- Collapsible tools. Open sections share the available dock height. -->
      <controls:WorkspaceDock x:Name="LeftDock" Grid.Column="0" Visibility="{Binding EditorChromeVisibility}"
                              LayoutChanged="OnDockLayoutChanged" LayoutSizeChanged="OnDockSizeChanged">
        <controls:WorkspacePanel PanelId="themes" Title="Themes" Icon="&#xE8F1;" IsOpen="False">
          <controls:ThemeLibraryPanel />
        </controls:WorkspacePanel>
        <controls:WorkspacePanel PanelId="widgets" Title="Widgets" Icon="&#xE710;" IsOpen="True">
        <controls:WorkspacePanel.Style><Style TargetType="controls:WorkspacePanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Document.Mode}" Value="{x:Static models:ScreenMode.InfoScreen}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></controls:WorkspacePanel.Style>
            <UniformGrid Columns="2" VerticalAlignment="Top">
              <Button Content="Text" Command="{Binding AddWidgetCommand}" CommandParameter="Text" ToolTip="Add a fixed text label." />
              <Button Content="Value" Command="{Binding AddWidgetCommand}" CommandParameter="Value" ToolTip="Add a label and live sensor value." />
              <Button Content="Circle" Command="{Binding AddWidgetCommand}" CommandParameter="CircularGauge" ToolTip="Add a circular sensor gauge." />
              <Button Content="Clock" Command="{Binding AddWidgetCommand}" CommandParameter="AnalogClock" ToolTip="Add a traditional analogue clock." />
              <Button Content="Bar" Command="{Binding AddWidgetCommand}" CommandParameter="BarGauge" ToolTip="Add a segmented horizontal gauge." />
              <Button Content="Graph" Command="{Binding AddWidgetCommand}" CommandParameter="Graph" ToolTip="Add a live history graph." />
              <Button Content="Shape" Command="{Binding AddWidgetCommand}" CommandParameter="Shape" ToolTip="Add a rectangle or ellipse." />
              <Button Content="Hardware name" Command="{Binding AddWidgetCommand}" CommandParameter="HardwareName" Padding="4,6" ToolTip="Automatically show your CPU, GPU, SSD or RAM name; edit the name afterwards." />
            </UniformGrid>
        </controls:WorkspacePanel>
        <controls:WorkspacePanel PanelId="media" Title="Media" Icon="&#xEB9F;" IsOpen="False">
        <controls:WorkspacePanel.Style><Style TargetType="controls:WorkspacePanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Document.Mode}" Value="{x:Static models:ScreenMode.InfoScreen}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></controls:WorkspacePanel.Style>
          <StackPanel>
            <UniformGrid Columns="2">
              <Button Content="Image" Command="{Binding ImportImageCommand}" ToolTip="Import a still image and add it to the canvas." />
              <Button Content="GIF" Command="{Binding ImportGifCommand}" ToolTip="Import an animated GIF and add it to the canvas." />
              <Button Content="Video" Command="{Binding ImportVideoCommand}" ToolTip="Play a silent video using Windows codecs. H.264 MP4 is recommended. Serial and USB screens have separate frame-rate limits." />
              <Button Content="Font" Command="{Binding ImportFontCommand}" ToolTip="Embed a redistributable font inside the theme file." />
            </UniformGrid>
            <TextBlock Text="{Binding VideoImportStatus}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="4,3,4,0" />
          </StackPanel>
        </controls:WorkspacePanel>
        <controls:WorkspacePanel PanelId="photos" Title="Photos" Icon="&#xE91B;" IsOpen="True">
        <controls:WorkspacePanel.Style><Style TargetType="controls:WorkspacePanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Document.Mode}" Value="{x:Static models:ScreenMode.PhotoFrame}"><Setter Property="Visibility" Value="Visible" /></DataTrigger><DataTrigger Binding="{Binding Document.Mode}" Value="{x:Static models:ScreenMode.Hybrid}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></controls:WorkspacePanel.Style>
            <StackPanel Margin="0,12,0,0">
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Document.Mode}" Value="{x:Static models:ScreenMode.PhotoFrame}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                    <DataTrigger Binding="{Binding Document.Mode}" Value="{x:Static models:ScreenMode.Hybrid}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>

              <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="4,2,0,7">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="Photo frame" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Document.Mode}" Value="{x:Static models:ScreenMode.Hybrid}">
                        <Setter Property="Text" Value="Hybrid" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>

              <Expander Header="Add photos" IsExpanded="True" Margin="0,6,0,0">
                <UniformGrid Columns="2" Margin="0,5,0,0">
                  <Button Content="Add files" Command="{Binding AddPhotosCommand}" Padding="10,7" ToolTip="Select one or several photo files. They remain linked to this PC." />
                  <Button Content="Add folder" Command="{Binding AddPhotoFolderCommand}" Padding="10,7" ToolTip="Add photos from a folder and its subfolders. Saving this mode's theme remembers the folder and reloads its photos when opened." />
                </UniformGrid>
              </Expander>

              <ListBox x:Name="PhotoPlaylist"
                       Height="220"
                       Margin="2,5"
                       ItemsSource="{Binding Document.PhotoFrame.Photos}"
                       SelectedItem="{Binding SelectedPhoto}"
                       AllowDrop="True"
                       PreviewMouseLeftButtonDown="OnPhotoPreviewMouseLeftButtonDown"
                       PreviewMouseMove="OnPhotoPreviewMouseMove"
                       DragOver="OnPhotoPlaylistDragOver"
                       Drop="OnPhotoPlaylistDrop"
                       ToolTip="Photo playlist. Drag items to change their order.">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="3">
                      <StackPanel>
                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="Linked file" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <UniformGrid Columns="2">
                <Button Content="Previous" Padding="6,5" Command="{Binding PreviousPhotoCommand}" ToolTip="Show the previous photo." />
                <Button Content="{Binding PhotoPlaybackLabel}" Command="{Binding TogglePhotoPlaybackCommand}" ToolTip="Pause or resume automatic playback." />
                <Button Content="Next" Command="{Binding NextPhotoCommand}" ToolTip="Show the next photo." />
                <Button Content="Remove" Command="{Binding RemovePhotoCommand}" ToolTip="Remove this photo from the playlist. The original file stays on your PC." />
              </UniformGrid>
              <TextBlock Text="{Binding PhotoPositionLabel}" HorizontalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />

              <Expander Header="Album settings" IsExpanded="True" Margin="0,6,0,0">
                <StackPanel Margin="0,5,0,0">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,4,0"><TextBlock Text="Photo duration (s)" Foreground="{StaticResource MutedTextBrush}" /><TextBox AutomationProperties.Name="Photo duration in seconds" controls:NumericValidation.Field="PhotoDuration" Text="{Binding Document.PhotoFrame.DefaultDurationSeconds, UpdateSourceTrigger=LostFocus}" ToolTip="How long every photo remains visible." /></StackPanel>
                    <StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBlock Text="Transition time (s)" Foreground="{StaticResource MutedTextBrush}" /><TextBox AutomationProperties.Name="Transition duration in seconds" controls:NumericValidation.Field="TransitionDuration" Text="{Binding Document.PhotoFrame.TransitionDurationSeconds, UpdateSourceTrigger=LostFocus}" ToolTip="Duration of the transition between photos." /></StackPanel>
                  </Grid>
                  <TextBlock Text="Transition" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
                  <ComboBox AutomationProperties.Name="Photo transition" ItemsSource="{Binding PhotoTransitions}" SelectedItem="{Binding Document.PhotoFrame.Transition}" ToolTip="Animation is used only while changing from one photo to the next." />
                  <TextBlock Text="Photo fit" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
                  <ComboBox AutomationProperties.Name="Photo fit" ItemsSource="{Binding MediaFits}" SelectedItem="{Binding Document.PhotoFrame.Fit}" ToolTip="Choose how photos fit the theme canvas." />
                  <TextBlock Text="Solid background colour" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
                  <controls:ColorPickerButton AutomationProperties.Name="Photo background colour" HexColor="{Binding Document.PhotoFrame.BackgroundColor}" ToolTip="Choose the solid colour shown around photos that do not fill the screen." />
                  <StackPanel Orientation="Horizontal">
                    <CheckBox Content="Loop" IsChecked="{Binding Document.PhotoFrame.Loop}" Margin="0,3,15,3" ToolTip="Restart at the beginning after the last photo." />
                    <CheckBox Content="Shuffle" IsChecked="{Binding Document.PhotoFrame.Shuffle}" ToolTip="Choose the next photo randomly." />
                  </StackPanel>
                  <CheckBox Content="Show captions" IsChecked="{Binding Document.PhotoFrame.ShowCaptions}" Margin="0,4,0,2" ToolTip="Show one globally configured caption style for all photos." />
                  <TextBlock Text="Caption source" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                  <ComboBox AutomationProperties.Name="Caption content" ItemsSource="{Binding PhotoCaptionModes}"
                            DisplayMemberPath="Label"
                            SelectedValuePath="Value"
                            SelectedValue="{Binding Document.PhotoFrame.CaptionMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="Missing EXIF dates or GPS locations remain blank instead of showing the file name." />
                  <StackPanel Margin="0,4,0,0">
                    <StackPanel.Style>
                      <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Document.PhotoFrame.CaptionMode}" Value="{x:Static models:PhotoCaptionMode.Custom}">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Custom caption text" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBox AutomationProperties.Name="Custom caption" Text="{Binding Document.PhotoFrame.CustomCaption, UpdateSourceTrigger=PropertyChanged}" ToolTip="One caption used for every photo." />
                  </StackPanel>
                  <TextBlock Text="Caption font" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0" />
                  <ComboBox AutomationProperties.Name="Caption font" ItemsSource="{Binding FontChoices}" IsEditable="True"
                            Text="{Binding Document.PhotoFrame.CaptionFontFamily, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="Choose the caption font for all photos. Includes built-in fonts and fonts installed on this PC." />
                  <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,4,0">
                      <TextBlock Text="Caption font size (px)" Foreground="{StaticResource MutedTextBrush}" />
                      <TextBox AutomationProperties.Name="Caption font size" controls:NumericValidation.Field="CaptionFontSize" Text="{Binding Document.PhotoFrame.CaptionFontSize, UpdateSourceTrigger=LostFocus}" ToolTip="Caption font size in screen pixels." />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                      <TextBlock Text="Caption text colour" Foreground="{StaticResource MutedTextBrush}" />
                      <controls:ColorPickerButton AutomationProperties.Name="Caption text colour" HexColor="{Binding Document.PhotoFrame.CaptionColor}" ToolTip="Caption text colour." />
                    </StackPanel>
                  </Grid>
                  <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,4,0">
                      <TextBlock Text="Outline colour" Foreground="{StaticResource MutedTextBrush}" />
                      <controls:ColorPickerButton AutomationProperties.Name="Caption outline colour" HexColor="{Binding Document.PhotoFrame.CaptionOutlineColor}" ToolTip="Thin outline around caption letters for readability." />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                      <TextBlock Text="Outline width (px)" Foreground="{StaticResource MutedTextBrush}" />
                      <TextBox AutomationProperties.Name="Caption outline thickness" controls:NumericValidation.Field="OutlineThickness" Text="{Binding Document.PhotoFrame.CaptionOutlineThickness, UpdateSourceTrigger=LostFocus}" ToolTip="Set to 0 for no outline." />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Expander>

              <Expander Header="Hybrid overlays" IsExpanded="True" Margin="0,6,0,0">
                <Expander.Style>
                  <Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Document.Mode}" Value="{x:Static models:ScreenMode.Hybrid}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Expander.Style>
                <StackPanel Margin="0,5,0,0">
                  <TextBlock Text="Add only the information you want over the photos." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="2,0,2,4" />
                  <UniformGrid Columns="2">
                    <Button Content="Text" Command="{Binding AddWidgetCommand}" CommandParameter="Text" ToolTip="Add a text overlay." />
                    <Button Content="Value" Command="{Binding AddWidgetCommand}" CommandParameter="Value" ToolTip="Add a sensor value overlay." />
                    <Button Content="Circle" Command="{Binding AddWidgetCommand}" CommandParameter="CircularGauge" ToolTip="Add a circular gauge overlay." />
                    <Button Content="Clock" Command="{Binding AddWidgetCommand}" CommandParameter="AnalogClock" ToolTip="Add a clock overlay." />
                    <Button Content="Bar" Command="{Binding AddWidgetCommand}" CommandParameter="BarGauge" ToolTip="Add a bar overlay." />
                    <Button Content="Graph" Command="{Binding AddWidgetCommand}" CommandParameter="Graph" ToolTip="Add a history graph overlay." />
                    <Button Content="Shape" Command="{Binding AddWidgetCommand}" CommandParameter="Shape" ToolTip="Add a rectangle, rounded rectangle, ellipse or line overlay." />
                    <Button Content="Hardware name" Command="{Binding AddWidgetCommand}" CommandParameter="HardwareName" ToolTip="Automatically show a CPU, GPU, SSD or RAM name over your photos." />
                    <Button Content="Video" Command="{Binding ImportVideoCommand}" ToolTip="Add a silent video overlay linked to its original file. Keep that file available when reopening Hybrid themes." />
                  </UniformGrid>
                  <TextBlock Text="{Binding VideoImportStatus}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="4,3,4,0" />
                </StackPanel>
              </Expander>

              <Expander Header="Watched folder &amp; playlists" IsExpanded="True" Margin="0,6,0,0">
                <StackPanel Margin="0,5,0,0">
                  <CheckBox Content="Watch folder for new photos" IsChecked="{Binding Document.PhotoFrame.WatchFolderEnabled}" ToolTip="Automatically add new images created in the selected folder." />
                  <TextBlock Text="{Binding Document.PhotoFrame.WatchedFolder}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedTextBrush}" ToolTip="{Binding Document.PhotoFrame.WatchedFolder}" />
                  <Button Content="Choose watched folder" Command="{Binding ChooseWatchedFolderCommand}" ToolTip="Select the folder monitored for new photos." />
                  <UniformGrid Columns="2">
                    <Button Content="Save playlist" Command="{Binding SaveAlbumPresetCommand}" ToolTip="Save this playlist as links to photos that remain on this PC." />
                    <Button Content="Load playlist" Command="{Binding LoadAlbumPresetCommand}" ToolTip="Replace the current playlist with a saved linked playlist." />
                  </UniformGrid>
                </StackPanel>
              </Expander>
            </StackPanel>
        </controls:WorkspacePanel>
        <controls:WorkspacePanel PanelId="layers" Title="Layers" Icon="&#xE81E;" IsOpen="True" IsScrollable="False">
        <controls:WorkspacePanel.Style><Style TargetType="controls:WorkspacePanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Document.Mode}" Value="{x:Static models:ScreenMode.InfoScreen}"><Setter Property="Visibility" Value="Visible" /></DataTrigger><DataTrigger Binding="{Binding Document.Mode}" Value="{x:Static models:ScreenMode.Hybrid}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></controls:WorkspacePanel.Style>
          <Grid>
            <Grid.Style>
              <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Document.Mode}" Value="{x:Static models:ScreenMode.PhotoFrame}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                </Style.Triggers>
              </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
              <RowDefinition Height="0" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ListBox x:Name="LayerList" Grid.Row="1" MinHeight="40" ItemsSource="{Binding Document.EditorWidgets}" SelectedItem="{Binding SelectedWidget}" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" AutomationProperties.Name="Layers">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                  <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                      <Setter Property="Background" Value="{StaticResource SelectedBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="3">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="26" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="44" />
                    </Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding IsVisible}" AutomationProperties.Name="{Binding Name, StringFormat=Show layer {0}}" ToolTip="Show or hide this layer on the canvas and display." HorizontalAlignment="Center" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                      <TextBlock Text="{Binding Type, Converter={StaticResource WidgetTypeLabelConverter}}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                    <CheckBox Grid.Column="2" IsChecked="{Binding IsLocked}" AutomationProperties.Name="{Binding Name, StringFormat=Lock layer {0}}" ToolTip="Lock this layer to prevent accidental movement or resizing." HorizontalAlignment="Center"><TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="12" /></CheckBox>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <UniformGrid Grid.Row="2" Columns="2" Margin="0,6,0,0">
              <Button Content="Up" Command="{Binding MoveLayerUpCommand}" ToolTip="Move the selected layer one level forward." />
              <Button Content="Down" Command="{Binding MoveLayerDownCommand}" ToolTip="Move the selected layer one level backward." />
              <Button Content="Duplicate" Command="{Binding DuplicateWidgetCommand}" Padding="6,6" ToolTip="Duplicate all selected widgets (Ctrl+D)." />
              <Button Content="Delete" Command="{Binding DeleteWidgetCommand}" ToolTip="Delete all selected widgets (Delete)." />
            </UniformGrid>
          </Grid>
        </controls:WorkspacePanel>
      </controls:WorkspaceDock>

      <!-- Center: real pixel canvas -->
      <Grid x:Name="CanvasArea" Grid.Column="1" Background="{StaticResource CanvasWellBrush}">
        <Grid.RowDefinitions>
          <RowDefinition Height="{Binding EditorTopBarHeight}" />
          <RowDefinition Height="*" />
          <RowDefinition Height="{Binding EditorBottomBarHeight}" />
        </Grid.RowDefinitions>
        <WrapPanel x:Name="CanvasToolbar" Grid.Row="0" Margin="12,6">
          <TextBlock VerticalAlignment="Center" Margin="0,4,14,4">
            <Run Text="Canvas  " Foreground="{StaticResource MutedTextBrush}" />
            <Run Text="{Binding Document.CanvasWidth}" /><Run Text=" × " /><Run Text="{Binding Document.CanvasHeight}" />
          </TextBlock>

          <StackPanel x:Name="AlignmentTools" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,12,2">
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Document.Mode}" Value="{x:Static models:ScreenMode.PhotoFrame}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>
            <TextBlock Text="Align" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,3,0" />
            <Button x:Name="AlignLeftButton" Command="{Binding AlignWidgetCommand}" CommandParameter="Left"
                    Style="{StaticResource AlignmentButtonStyle}" AutomationProperties.Name="Align left"
                    ToolTip="Align left. One widget: canvas; multiple widgets: selection bounds.">
              <Path Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.5" StrokeLineJoin="Round"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    Data="M2,1 L2,19 M5,4 L17,4 L17,8 L5,8 Z M5,12 L13,12 L13,16 L5,16 Z" />
            </Button>
            <Button x:Name="AlignCenterButton" Command="{Binding AlignWidgetCommand}" CommandParameter="Center"
                    Style="{StaticResource AlignmentButtonStyle}" AutomationProperties.Name="Centre horizontally"
                    ToolTip="Centre horizontally. One widget: canvas; multiple widgets: selection bounds.">
              <Path Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.5" StrokeLineJoin="Round"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    Data="M10,1 L10,19 M3,4 L17,4 L17,8 L3,8 Z M6,12 L14,12 L14,16 L6,16 Z" />
            </Button>
            <Button x:Name="AlignRightButton" Command="{Binding AlignWidgetCommand}" CommandParameter="Right"
                    Style="{StaticResource AlignmentButtonStyle}" AutomationProperties.Name="Align right"
                    ToolTip="Align right. One widget: canvas; multiple widgets: selection bounds.">
              <Path Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.5" StrokeLineJoin="Round"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    Data="M18,1 L18,19 M3,4 L15,4 L15,8 L3,8 Z M7,12 L15,12 L15,16 L7,16 Z" />
            </Button>
            <Button x:Name="AlignTopButton" Command="{Binding AlignWidgetCommand}" CommandParameter="Top"
                    Style="{StaticResource AlignmentButtonStyle}" AutomationProperties.Name="Align top"
                    ToolTip="Align top. One widget: canvas; multiple widgets: selection bounds.">
              <Path Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.5" StrokeLineJoin="Round"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    Data="M1,2 L19,2 M4,5 L8,5 L8,17 L4,17 Z M12,5 L16,5 L16,13 L12,13 Z" />
            </Button>
            <Button x:Name="AlignMiddleButton" Command="{Binding AlignWidgetCommand}" CommandParameter="Middle"
                    Style="{StaticResource AlignmentButtonStyle}" AutomationProperties.Name="Centre vertically"
                    ToolTip="Centre vertically. One widget: canvas; multiple widgets: selection bounds.">
              <Path Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.5" StrokeLineJoin="Round"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    Data="M1,10 L19,10 M4,3 L8,3 L8,17 L4,17 Z M12,6 L16,6 L16,14 L12,14 Z" />
            </Button>
            <Button x:Name="AlignBottomButton" Command="{Binding AlignWidgetCommand}" CommandParameter="Bottom"
                    Style="{StaticResource AlignmentButtonStyle}" AutomationProperties.Name="Align bottom"
                    ToolTip="Align bottom. One widget: canvas; multiple widgets: selection bounds.">
              <Path Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.5" StrokeLineJoin="Round"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    Data="M1,18 L19,18 M4,3 L8,3 L8,15 L4,15 Z M12,7 L16,7 L16,15 L12,15 Z" />
            </Button>
          </StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,12,2" Visibility="{Binding InspectorChromeVisibility}">
            <Button Content="Group" Command="{Binding GroupSelectedCommand}" Padding="7,3" ToolTip="Group selected widgets (Ctrl+G)" />
            <Button Content="Ungroup" Command="{Binding UngroupSelectedCommand}" Padding="7,3" ToolTip="Ungroup selected widgets (Ctrl+Shift+G)" />
          </StackPanel>

          <StackPanel x:Name="CanvasViewTools" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,2">
            <StackPanel Orientation="Horizontal">
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Setter Property="Visibility" Value="Visible" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Document.Mode}" Value="{x:Static models:ScreenMode.PhotoFrame}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <CheckBox Content="Grid" IsChecked="{Binding Document.EditorGridVisible}" Margin="4,0,8,0" ToolTip="Show or hide the editor grid. It is not included in the display output." />
              <CheckBox Content="Snap" IsChecked="{Binding Document.SnapToGrid}" Margin="0,0,8,0" ToolTip="Snap dragging, resizing, and arrow-key movement to the configured grid spacing." />
              <TextBlock Text="Grid px" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
              <TextBox AutomationProperties.Name="Grid spacing in screen pixels" Width="42" Text="{Binding Document.GridSize, UpdateSourceTrigger=LostFocus}" ToolTip="Grid spacing in screen pixels" />
            </StackPanel>
          </StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,2">
            <CheckBox Content="Fit" IsChecked="{Binding IsCanvasFit}" Margin="4,0,8,0" ToolTip="Fit the complete canvas whenever the window or panels resize." />
            <Button Content="100%" Click="OnActualSizeClick" Padding="6,3" ToolTip="View one screen pixel per editor unit." />
            <TextBlock Text="Zoom" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="10,0,4,0" />
            <Slider AutomationProperties.Name="Canvas zoom" Width="74" Minimum="0.1" Maximum="3" SmallChange="0.1" LargeChange="0.5"
                    Value="{Binding CanvasZoom}" IsEnabled="{Binding CanAdjustCanvasZoom}" ToolTip="Manual preview zoom. Clear Fit to adjust; the theme resolution stays fixed." />
            <TextBlock Text="{Binding CanvasZoomLabel}" Width="42" VerticalAlignment="Center" Margin="5,0,0,0" />
          </StackPanel>
          <Button Content="Reset workspace" Click="OnResetWorkspaceClick" Style="{StaticResource QuietButtonStyle}" Padding="7,4" ToolTip="Restore panel positions, open sections, widths and canvas fitting. Your theme is preserved." />
        </WrapPanel>
        <Border Grid.Row="1" Margin="12" Background="{StaticResource CanvasWellBrush}">
          <controls:DesignerSurface x:Name="Designer" />
        </Border>
        <Grid Grid.Row="2" Margin="12,0">
          <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Text" Value="Live sensor readings are enabled. Choose Preview.Value as a data source to set a design value." />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Document.Mode}" Value="{x:Static models:ScreenMode.PhotoFrame}"><Setter Property="Text" Value="Photo preview. Slideshow settings and sources are in the left workspace." /></DataTrigger>
                  <DataTrigger Binding="{Binding Document.Mode}" Value="{x:Static models:ScreenMode.Hybrid}"><Setter Property="Text" Value="Arrange the selected Hybrid overlay over the photo preview." /></DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
      </Grid>

      <controls:WorkspaceDock x:Name="RightDock" Grid.Column="2" RailOnRight="True"
                              Visibility="{Binding InspectorChromeVisibility}"
                              LayoutChanged="OnDockLayoutChanged" LayoutSizeChanged="OnDockSizeChanged">
        <controls:WorkspacePanel PanelId="properties" Title="Properties" Icon="&#xE713;" IsOpen="True">
          <StackPanel>
            <TextBlock Text="Select an item on the canvas or in Layers." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="2,20">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedWidget}" Value="{x:Null}">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>

            <ContentControl x:Name="WidgetProperties" Content="{Binding SelectedWidget}">
              <ContentControl.Style>
                <Style TargetType="ContentControl">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedWidget}" Value="{x:Null}">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ContentControl.Style>
              <ContentControl.ContentTemplate>
                <DataTemplate DataType="{x:Type models:WidgetModel}">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                      <CheckBox DockPanel.Dock="Right" Content="Lock" IsChecked="{Binding IsLocked}" Margin="10,0,0,0" VerticalAlignment="Center" ToolTip="Prevent this widget from being moved, resized, or aligned." />
                      <TextBlock Text="{Binding Type, Converter={StaticResource WidgetTypeLabelConverter}}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </DockPanel>

                    <TextBlock Text="Name" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBox AutomationProperties.Name="Layer name" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,8" ToolTip="The name shown for this widget in the Layers list." />

                    <Expander Header="Hardware name" IsExpanded="True" Margin="0,8,0,0">
                      <Expander.Style><Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers><DataTrigger Binding="{Binding Type}" Value="{x:Static models:WidgetType.HardwareName}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                      </Style></Expander.Style>
                      <StackPanel Margin="0,5,0,0">
                        <TextBlock Text="Component" Foreground="{StaticResource MutedTextBrush}" />
                        <ComboBox AutomationProperties.Name="Hardware component" ItemsSource="{Binding DataContext.HardwareNameSources, RelativeSource={RelativeSource AncestorType=Window}}"
                                  DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding DataSource}" Margin="0,3,0,7" />
                        <CheckBox Content="Use detected name" IsChecked="{Binding UseDetectedHardwareName}" ToolTip="Re-enable automatic detection to use this PC's actual hardware name." />
                        <TextBlock Text="Displayed name" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
                        <TextBox AutomationProperties.Name="Displayed hardware name" x:Name="HardwareNameTextEditor" Text="{Binding HardwareNameText, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,7"
                                 ToolTip="Edit the detected name, or add emojis. Editing switches to your custom name; updates will not overwrite it." />
                        <TextBlock Text="Editing keeps your custom name. Tick Use detected name to return to automatic. Some PC firmware omits the RAM brand."
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" />
                      </StackPanel>
                    </Expander>

                    <Expander Header="Position &amp; size"
                              IsExpanded="{Binding DataContext.PositionPanelExpanded, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                              Margin="0,10,0,2">
                      <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="X" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBox AutomationProperties.Name="Horizontal position in pixels" controls:NumericValidation.Field="NonNegative" Grid.Row="0" Grid.Column="1" Text="{Binding X, UpdateSourceTrigger=LostFocus}" Margin="0,2,8,2" ToolTip="Horizontal position in screen pixels from the left edge." />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Y" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBox AutomationProperties.Name="Vertical position in pixels" controls:NumericValidation.Field="NonNegative" Grid.Row="0" Grid.Column="3" Text="{Binding Y, UpdateSourceTrigger=LostFocus}" Margin="0,2,0,2" ToolTip="Vertical position in screen pixels from the top edge." />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="W" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBox AutomationProperties.Name="Widget width in pixels" controls:NumericValidation.Field="Size" Grid.Row="1" Grid.Column="1" Text="{Binding Width, UpdateSourceTrigger=LostFocus}" Margin="0,2,8,2" ToolTip="Widget width in screen pixels." />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="H" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBox AutomationProperties.Name="Widget height in pixels" controls:NumericValidation.Field="Size" Grid.Row="1" Grid.Column="3" Text="{Binding Height, UpdateSourceTrigger=LostFocus}" Margin="0,2,0,2" ToolTip="Widget height in screen pixels." />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Rot" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBox AutomationProperties.Name="Widget rotation in degrees" controls:NumericValidation.Field="Number" Grid.Row="2" Grid.Column="1" Text="{Binding Rotation, UpdateSourceTrigger=LostFocus}" Margin="0,2,8,2" ToolTip="Rotate this widget clockwise by the entered number of degrees." />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Opacity" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBox AutomationProperties.Name="Widget opacity" controls:NumericValidation.Field="Opacity" Grid.Row="2" Grid.Column="3" Text="{Binding Opacity, UpdateSourceTrigger=LostFocus}" Margin="0,2,0,2" ToolTip="Widget opacity from 0 (transparent) to 1 (fully visible)." />
                      </Grid>
                    </Expander>

                    <!-- Data controls -->
                    <Expander Header="Data"
                              IsExpanded="{Binding DataContext.DataPanelExpanded, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                              Margin="0,8,0,0">
                      <Expander.Style>
                        <Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:WidgetType.Text}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:WidgetType.Value}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:WidgetType.CircularGauge}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:WidgetType.BarGauge}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:WidgetType.Graph}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Expander.Style>
                      <StackPanel Margin="0,5,0,0">

                      <CheckBox AutomationProperties.Name="Show advanced hardware sensors"
                                IsChecked="{Binding DataContext.ShowAdvancedSensors, RelativeSource={RelativeSource AncestorType=Window}}"
                                Margin="0,0,0,7"
                                ToolTip="Include raw LibreHardwareMonitor and HWiNFO sensor entries in the Source list." ><TextBlock Text="Show advanced hardware sensors" TextWrapping="Wrap" /></CheckBox>

                      <StackPanel Margin="0,2,0,8">
                        <StackPanel.Style>
                          <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding DataSource}" Value="Weather.Temperature"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                              <DataTrigger Binding="{Binding DataSource}" Value="Weather.FeelsLike"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                              <DataTrigger Binding="{Binding DataSource}" Value="Weather.Humidity"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                              <DataTrigger Binding="{Binding DataSource}" Value="Weather.Wind"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                              <DataTrigger Binding="{Binding DataSource}" Value="Weather.WindDirection"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                              <DataTrigger Binding="{Binding DataSource}" Value="Weather.WindGust"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                              <DataTrigger Binding="{Binding DataSource}" Value="Weather.Condition"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                              <DataTrigger Binding="{Binding DataSource}" Value="Weather.Location"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                              <DataTrigger Binding="{Binding DataSource}" Value="Weather.Precipitation"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                              <DataTrigger Binding="{Binding DataSource}" Value="Weather.PrecipitationChance"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                              <DataTrigger Binding="{Binding DataSource}" Value="Weather.CloudCover"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                              <DataTrigger Binding="{Binding DataSource}" Value="Weather.Pressure"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                              <DataTrigger Binding="{Binding DataSource}" Value="Weather.DayNight"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                              <DataTrigger Binding="{Binding DataSource}" Value="Weather.TodayHigh"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                              <DataTrigger Binding="{Binding DataSource}" Value="Weather.TodayLow"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                              <DataTrigger Binding="{Binding DataSource}" Value="Weather.TodayCondition"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                              <DataTrigger Binding="{Binding DataSource}" Value="Weather.Sunrise"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                              <DataTrigger Binding="{Binding DataSource}" Value="Weather.Sunset"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </StackPanel.Style>

                        <TextBlock Text="Weather city" Foreground="{StaticResource MutedTextBrush}" />
                        <Grid Margin="0,3,0,2">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBox AutomationProperties.Name="Weather city" Text="{Binding DataContext.WeatherCity, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                                   ToolTip="City or City, Country, for example Düsseldorf, Germany" />
                          <Button Grid.Column="1"
                                  Content="Update"
                                  Command="{Binding DataContext.UpdateWeatherCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  Margin="6,0,0,0"
                                  Padding="9,4"
                                  ToolTip="Download the latest weather data for the entered city." />
                        </Grid>
                        <TextBlock Text="{Binding DataContext.WeatherStatus, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="10"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                      <TextBlock Text="Label" Foreground="{StaticResource MutedTextBrush}" />
                      <TextBox AutomationProperties.Name="Widget label" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,7" ToolTip="Text displayed as this widget's label." />
                      <Grid>
                        <Grid.Style>
                          <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding DataSource}" Value="Preview.Value"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="72" /></Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="Preview value" Foreground="{StaticResource MutedTextBrush}" />
                          <Slider AutomationProperties.Name="Preview value" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding SimulatedValue}" ToolTip="Set the design value for the Preview.Value data source." />
                        </StackPanel>
                        <TextBox AutomationProperties.Name="Preview value" controls:NumericValidation.Field="Number" Grid.Column="1" Text="{Binding SimulatedValue, UpdateSourceTrigger=LostFocus}" Margin="8,18,0,0" ToolTip="Enter an exact design value for the Preview.Value data source." />
                      </Grid>
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,0"><TextBlock Text="Min" Foreground="{StaticResource MutedTextBrush}" /><TextBox AutomationProperties.Name="Minimum value" controls:NumericValidation.Field="Minimum" Text="{Binding Minimum, UpdateSourceTrigger=LostFocus}" ToolTip="Lowest value represented by this gauge or graph." /></StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0"><TextBlock Text="Max" Foreground="{StaticResource MutedTextBrush}" /><TextBox AutomationProperties.Name="Maximum value" controls:NumericValidation.Field="Maximum" Text="{Binding Maximum, UpdateSourceTrigger=LostFocus}" ToolTip="Highest value represented by this gauge or graph." /></StackPanel>
                        <StackPanel Grid.Column="2" Margin="5,0,0,0"><TextBlock Text="Suffix" Foreground="{StaticResource MutedTextBrush}" /><TextBox AutomationProperties.Name="Value suffix" Text="{Binding Suffix, UpdateSourceTrigger=PropertyChanged}" ToolTip="Unit or text displayed after the value, for example %, °C, or GB." /></StackPanel>
                      </Grid>
                      <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <CheckBox Content="Label" IsChecked="{Binding ShowLabel}" Margin="0,0,14,0" ToolTip="Show or hide the widget label." />
                        <CheckBox Content="Value" IsChecked="{Binding ShowValue}" ToolTip="Show or hide the sensor value." />
                      </StackPanel>
                      </StackPanel>
                    </Expander>

                    <!-- Typography -->
                    <Expander Header="Typography"
                              IsExpanded="{Binding DataContext.TypographyPanelExpanded, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                              Margin="0,8,0,0">
                      <Expander.Style>
                        <Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
                          <Setter Property="Visibility" Value="Visible" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:WidgetType.Image}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:WidgetType.AnimatedImage}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:WidgetType.Video}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:WidgetType.Shape}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:WidgetType.AnalogClock}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Expander.Style>
                      <StackPanel Margin="0,5,0,0">
                      <TextBlock Text="Font" Foreground="{StaticResource MutedTextBrush}" />
                      <ComboBox AutomationProperties.Name="Widget font" ItemsSource="{Binding DataContext.FontChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                IsEditable="True"
                                IsTextSearchEnabled="True"
                                Text="{Binding FontFamily, UpdateSourceTrigger=PropertyChanged}"
                                Margin="0,3,0,6"
                                ToolTip="Includes built-in Bungee, Fredoka, Monoton and Orbitron fonts. You can also type an installed Windows font name." />
                      <TextBlock Text="Embedded custom font" Foreground="{StaticResource MutedTextBrush}" />
                      <ComboBox AutomationProperties.Name="Embedded font" ItemsSource="{Binding DataContext.FontAssets, RelativeSource={RelativeSource AncestorType=Window}}"
                                DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectedValue="{Binding FontAssetId}" Margin="0,3,0,6"
                                ToolTip="Choose a custom font embedded in this theme." />
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="Size" Foreground="{StaticResource MutedTextBrush}" />
                          <TextBox AutomationProperties.Name="Widget font size" controls:NumericValidation.Field="FontSize" Text="{Binding FontSize, UpdateSourceTrigger=LostFocus}"
                                   ToolTip="Fixed text size in screen pixels. Resizing the widget does not change it." />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Content="Bold" IsChecked="{Binding FontBold}" Margin="12,18,5,0" ToolTip="Use the bold font style." />
                        <CheckBox Grid.Column="2" Content="Italic" IsChecked="{Binding FontItalic}" Margin="5,18,0,0" ToolTip="Use the italic font style." />
                      </Grid>
                      </StackPanel>
                    </Expander>

                    <!-- Graph -->
                    <Expander Header="Graph"
                              IsExpanded="{Binding DataContext.GraphPanelExpanded, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                              Margin="0,8,0,0">
                      <Expander.Style>
                        <Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers><DataTrigger Binding="{Binding Type}" Value="{x:Static models:WidgetType.Graph}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style>
                      </Expander.Style>
                      <StackPanel Margin="0,5,0,0">
                      <TextBlock Text="Style" Foreground="{StaticResource MutedTextBrush}" />
                      <ComboBox AutomationProperties.Name="Graph style" ItemsSource="{Binding DataContext.GraphStyles, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding GraphStyle}" Margin="0,3,0,6" ToolTip="Choose how graph history is drawn." />
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,5,0"><TextBlock Text="History (s)" Foreground="{StaticResource MutedTextBrush}" /><TextBox AutomationProperties.Name="Graph history in seconds" controls:NumericValidation.Field="History" Text="{Binding HistorySeconds, UpdateSourceTrigger=LostFocus}" ToolTip="Number of seconds of sensor history shown in the graph." /></StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="Line width" Foreground="{StaticResource MutedTextBrush}" /><TextBox AutomationProperties.Name="Line thickness" controls:NumericValidation.Field="Thickness" Text="{Binding LineThickness, UpdateSourceTrigger=LostFocus}" ToolTip="Thickness of graph lines in screen pixels." /></StackPanel>
                      </Grid>
                      <StackPanel Orientation="Horizontal"><CheckBox Content="Grid" IsChecked="{Binding ShowGrid}" Margin="0,4,15,0" ToolTip="Draw reference grid lines behind the graph." /><CheckBox Content="Auto scale" IsChecked="{Binding AutoScale}" Margin="0,4,0,0" ToolTip="Adjust the graph range automatically to recent values." /></StackPanel>
                      </StackPanel>
                    </Expander>

                    <!-- Gauge -->
                    <Expander Header="Gauge"
                              IsExpanded="{Binding DataContext.GaugePanelExpanded, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                              Margin="0,8,0,0">
                      <Expander.Style>
                        <Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:WidgetType.CircularGauge}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:WidgetType.BarGauge}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Expander.Style>
                      <StackPanel Margin="0,5,0,0">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,5,0"><TextBlock Text="Thickness" Foreground="{StaticResource MutedTextBrush}" /><TextBox AutomationProperties.Name="Gauge thickness" controls:NumericValidation.Field="Thickness" Text="{Binding GaugeThickness, UpdateSourceTrigger=LostFocus}" ToolTip="Thickness of the gauge track and active indicator." /></StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="Segments" Foreground="{StaticResource MutedTextBrush}" /><TextBox AutomationProperties.Name="Segment count" controls:NumericValidation.Field="Segments" Text="{Binding SegmentCount, UpdateSourceTrigger=LostFocus}" ToolTip="Number of blocks used by a segmented bar gauge." /></StackPanel>
                      </Grid>
                      </StackPanel>
                    </Expander>

                    <!-- Media -->
                    <Expander Header="Media"
                              IsExpanded="{Binding DataContext.MediaPanelExpanded, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                              Margin="0,8,0,0">
                      <Expander.Style>
                        <Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:WidgetType.Image}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:WidgetType.AnimatedImage}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:WidgetType.Video}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Expander.Style>
                      <StackPanel Margin="0,5,0,0">
                      <TextBlock Text="Fit" Foreground="{StaticResource MutedTextBrush}" />
                      <ComboBox AutomationProperties.Name="Media fit" ItemsSource="{Binding DataContext.MediaFits, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding MediaFit}" Margin="0,3,0,5" ToolTip="Choose how media is fitted inside the widget bounds." />
                      <CheckBox Content="Loop" IsChecked="{Binding Loop}" ToolTip="Restart animated media when it reaches the end." />
                      <StackPanel>
                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Type}" Value="{x:Static models:WidgetType.Video}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <CheckBox Content="Pause video" IsChecked="{Binding MediaPaused}" />
                        <Button Content="Restart video" Command="{Binding DataContext.RestartVideoCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding RuntimeMediaStatus}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,4,0,4" />
                        <TextBlock Text="Silent playback, up to two videos. Sources up to 4K are scaled to the screen. 3.5-inch: 3 fps Auto, 5 fps maximum. 5.2-inch: 12 fps Auto, 20 fps maximum. Transfer speed may lower these limits. 3.5-inch full-screen video can visibly repaint; a smaller video area reduces transfer work. Use Restart video if playback stops." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,0,0,5" />
                      </StackPanel>
                      <CheckBox Content="Automatic optimization" IsChecked="{Binding AutoOptimize}" ToolTip="For video, use the conservative display-specific Auto frame rate. Output remains bounded when disabled." />
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,5,0"><TextBlock Text="Speed" Foreground="{StaticResource MutedTextBrush}" /><TextBox AutomationProperties.Name="Playback speed" controls:NumericValidation.Field="PlaybackSpeed" Text="{Binding PlaybackSpeed, UpdateSourceTrigger=LostFocus}" ToolTip="Playback speed multiplier, for example 0.5 for half speed or 2 for double speed." /></StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="FPS (0=Auto)" Foreground="{StaticResource MutedTextBrush}" /><TextBox AutomationProperties.Name="Target frames per second" controls:NumericValidation.Field="Fps" controls:NumericValidation.Maximum="{Binding DataContext.VideoMaximumFps, RelativeSource={RelativeSource AncestorType=Window}}" Text="{Binding TargetFps, UpdateSourceTrigger=LostFocus}" ToolTip="Video limits: 3.5-inch up to 5 fps, 5.2-inch up to 20 fps. Use 0 for automatic timing. GIFs allow up to 60 fps." /></StackPanel>
                      </Grid>
                      </StackPanel>
                    </Expander>

                    <!-- Shape -->
                    <Expander Header="Shape"
                              IsExpanded="{Binding DataContext.ShapePanelExpanded, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                              Margin="0,8,0,0">
                      <Expander.Style>
                        <Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Type}" Value="{x:Static models:WidgetType.Shape}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
                      </Expander.Style>
                      <StackPanel Margin="0,5,0,0">
                      <ComboBox AutomationProperties.Name="Shape style" ItemsSource="{Binding DataContext.ShapeStyles, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding ShapeStyle}" ToolTip="Choose the shape geometry." />
                      <TextBlock Text="Corner radius" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0" />
                      <TextBox AutomationProperties.Name="Shape corner radius" controls:NumericValidation.Field="NonNegative" Text="{Binding CornerRadius, UpdateSourceTrigger=LostFocus}" ToolTip="Set how rounded the shape corners are, in pixels." />
                      </StackPanel>
                    </Expander>

                    <Expander Header="Colours"
                              IsExpanded="{Binding DataContext.ColoursPanelExpanded, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                              Margin="0,8,0,0">
                      <StackPanel Margin="0,5,0,0">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                      <StackPanel Margin="0,0,5,0"><TextBlock Text="Text" Foreground="{StaticResource MutedTextBrush}" /><controls:ColorPickerButton AutomationProperties.Name="Text colour" HexColor="{Binding ForegroundColor}" /></StackPanel>
                      <StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="Graph / accent" Foreground="{StaticResource MutedTextBrush}" /><controls:ColorPickerButton AutomationProperties.Name="Accent colour" HexColor="{Binding AccentColor}" /></StackPanel>
                    </Grid>
                    <Grid Margin="0,5,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                      <StackPanel Margin="0,0,5,0"><TextBlock Text="Background" Foreground="{StaticResource MutedTextBrush}" /><controls:ColorPickerButton AutomationProperties.Name="Widget background colour" HexColor="{Binding BackgroundColor}" PreserveAlpha="True" ToolTip="Choose the widget background colour. Use Background transparency below to make it visible or transparent." /></StackPanel>
                      <StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="Track / grid" Foreground="{StaticResource MutedTextBrush}" /><controls:ColorPickerButton AutomationProperties.Name="Track and grid colour" HexColor="{Binding SecondaryColor}" /></StackPanel>
                    </Grid>
                    <TextBlock Text="Background transparency (%)" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,2" />
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="55" /></Grid.ColumnDefinitions>
                      <Slider AutomationProperties.Name="Background transparency percentage" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                              Value="{Binding BackgroundTransparency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              VerticalAlignment="Center" Margin="0,0,8,0"
                              ToolTip="0% is solid; 100% is invisible. Only the widget background changes." />
                      <TextBox AutomationProperties.Name="Background transparency percentage" controls:NumericValidation.Field="Transparency" Grid.Column="1" Text="{Binding BackgroundTransparency, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F0}"
                               ToolTip="Background transparency from 0 to 100%. Text, images, gauges and outlines stay unchanged." />
                    </Grid>
                      </StackPanel>
                    </Expander>
                  </StackPanel>
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>
          </StackPanel>
        </controls:WorkspacePanel>
        <controls:WorkspacePanel PanelId="sensors" Title="Sensors" Icon="&#xE9D9;" IsOpen="False">
          <StackPanel>            <Grid Margin="2,0,2,4">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBox AutomationProperties.Name="Find a sensor" x:Name="SourceSearchBox" TextChanged="OnSourceSearchChanged" Text="{Binding SourceSearchText, UpdateSourceTrigger=PropertyChanged}"
                       IsEnabled="{Binding CanSearchSources}"
                       ToolTip="Filter the selected widget's Source list, for example GPU, CPU temperature or clock. Searching does not add widgets or change their current sensor." />
              <Button Grid.Column="1" Content="Clear" Command="{Binding ClearSourceSearchCommand}"
                      Visibility="{Binding ClearSourceSearchVisibility}" Margin="6,0,0,0" Padding="7,4"
                      ToolTip="Clear the search and show all data sources." />
            </Grid>
            <TextBlock Text="{Binding SourceSearchHint}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="3,0,3,8" />
            <StackPanel>
              <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers><DataTrigger Binding="{Binding CanSearchSources}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
              </Style></StackPanel.Style>
              <TextBlock Text="Source" Foreground="{StaticResource MutedTextBrush}" />
              <controls:SourcePicker AutomationProperties.Name="Sensor source" x:Name="SourceSearchResults" Style="{StaticResource {x:Type ComboBox}}"
                                    ItemsSource="{Binding FilteredDataSources}"
                                    SelectedSource="{Binding SelectedWidget.DataSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Margin="0,3,0,7"
                                    ToolTip="Choose a sensor from the filtered results. This updates the selected widget only." />
            </StackPanel>
          </StackPanel>
        </controls:WorkspacePanel>
      </controls:WorkspaceDock>
    </Grid>

    <!-- status -->
    <Border Grid.Row="1" Visibility="{Binding HardwarePageVisibility}"><controls:HardwareDashboard DataContext="{Binding HardwareDashboard}" /></Border>

    <Border Grid.Row="2" Background="{StaticResource WorkspaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
      <Grid Margin="10,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding DeviceStatus}" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" MaxWidth="240" TextTrimming="CharacterEllipsis" ToolTip="{Binding DeviceStatus}" />
        <DockPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
          <ProgressBar Width="54" Height="4" Foreground="{StaticResource AccentBrush}" Background="{StaticResource StrongBorderBrush}" BorderThickness="0" IsIndeterminate="True" Visibility="{Binding FileOperationVisibility}" Margin="0,0,8,0" />
          <Button Content="Cancel" Command="{Binding CancelFileOperationCommand}" Visibility="{Binding FileOperationVisibility}" Padding="7,1" MinHeight="20" Height="24" Margin="0,0,8,0" AutomationProperties.Name="Cancel file operation" />
          <Button Content="Dismiss" Command="{Binding DismissRecoveryNoticeCommand}" Visibility="{Binding RecoveryNoticeVisibility}" Padding="7,1" MinHeight="20" Height="24" Margin="0,0,8,0" AutomationProperties.Name="Dismiss recovery notice" />
          <TextBlock Text="{Binding ActivityStatus}" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ActivityStatus}" />
        </DockPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <TextBlock Text="Theme: " Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding CurrentThemeName}" MaxWidth="250" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Guided setup is shown only on a genuinely new installation. -->
    <Grid Grid.RowSpan="3" Background="{StaticResource ModalScrimBrush}" Panel.ZIndex="50">
      <Grid.Style>
        <Style TargetType="Grid">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsFirstRunVisible}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
          </Style.Triggers>
        </Style>
      </Grid.Style>
      <Border Width="610" Padding="30" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
          <TextBlock Text="Welcome to PC Info Screen Studio" FontSize="25" FontWeight="SemiBold" />
          <TextBlock Text="Connect the screen, choose how you want to use it, and start with a useful layout." Foreground="{StaticResource MutedTextBrush}" FontSize="14" TextWrapping="Wrap" Margin="0,6,0,22" />

          <TextBlock Text="1  Screen" Style="{StaticResource SectionTitleStyle}" />
          <Button Content="Detect and connect screen" Command="{Binding FirstRunConnectCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Padding="18,8" Margin="0,7,0,5" />
          <TextBlock Text="{Binding FirstRunStatus}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />

          <TextBlock Text="2  Mode" Style="{StaticResource SectionTitleStyle}" Margin="0,22,0,7" />
          <ComboBox AutomationProperties.Name="Screen mode" ItemsSource="{Binding ScreenModes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Document.Mode}" FontSize="14" />

          <TextBlock Text="3  Starting layout" Style="{StaticResource SectionTitleStyle}" Margin="0,22,0,7" />
          <CheckBox Content="Use the starter theme with sensible CPU, GPU, and RAM widgets" IsChecked="{Binding FirstRunUseStarterTheme}" />
          <TextBlock Text="Turn this off to start with a blank canvas. Photo files always stay on this PC." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="22,3,0,0" />

          <Button Content="Finish setup" Command="{Binding CompleteFirstRunCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" Padding="24,9" Margin="0,24,0,0" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
