<Window x:Class="PCInfoScreenStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PCInfoScreenStudio.Controls"
        xmlns:models="clr-namespace:PCInfoScreenStudio.Models"
        Title="{Binding WindowTitle}"
        Icon="{StaticResource AppIconImage}"
        Width="1480" Height="880" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Closing="OnClosing" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
  <Window.InputBindings>
    <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand}" />
    <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}" />
    <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
    <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsCommand}" />
    <KeyBinding Key="Delete" Command="{Binding DeleteWidgetCommand}" />
    <KeyBinding Key="D" Modifiers="Control" Command="{Binding DuplicateWidgetCommand}" />
  </Window.InputBindings>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="52" />
      <RowDefinition Height="*" />
      <RowDefinition Height="30" />
    </Grid.RowDefinitions>

    <!-- Top toolbar -->
    <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
      <DockPanel Margin="8,5">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
          <Button Content="New" Command="{Binding NewCommand}" />
          <Button Content="Open" Command="{Binding OpenCommand}" />
          <Button Content="Save" Command="{Binding SaveCommand}" />
          <Button Content="Save as" Command="{Binding SaveAsCommand}" />
          <Separator Margin="7,3" />
          <Button Command="{Binding ToggleOrientationCommand}" Padding="12,6">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Layout: " Foreground="{StaticResource MutedTextBrush}" />
              <TextBlock Text="{Binding Document.Orientation}" />
            </StackPanel>
          </Button>
          <TextBlock Text="Mount" Margin="12,0,4,0" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
          <ComboBox Width="92" ItemsSource="{Binding RotationOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Document.DeviceRotation}" VerticalContentAlignment="Center" />
          <Button Content="Rotate" Command="{Binding RotateDeviceCommand}" />
          <CheckBox Content="Live data" IsChecked="{Binding UseLiveData}" VerticalAlignment="Center" Margin="12,0,0,0" />
          <Button Content="Hardware sensors..."
                  Command="{Binding EnableFullSensorsCommand}"
                  Margin="8,0,0,0"
                  Padding="9,5"
                  ToolTip="Install/enable the optional low-level sensor driver when needed and restart with elevated access" />
          <CheckBox Content="Live display" IsChecked="{Binding LivePreview}" VerticalAlignment="Center" Margin="12,0,0,0" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
          <ComboBox Width="245"
                    ItemsSource="{Binding Ports}"
                    DisplayMemberPath="DisplayName"
                    SelectedValuePath="PortName"
                    SelectedValue="{Binding SelectedPort}"
                    VerticalContentAlignment="Center"
                    ToolTip="Detected serial devices" />
          <Button Content="Refresh ports" Command="{Binding RefreshPortsCommand}" />
          <Button Content="Detect screen" Command="{Binding DetectScreenCommand}" ToolTip="Find the most likely USB serial screen automatically" />
          <Button Content="Color test" Command="{Binding TestScreenCommand}" ToolTip="Send a full-screen RGB/C/M/Y color diagnostic pattern using the selected protocol and color mode" />
          <Button Content="Connect / Disconnect" Command="{Binding ConnectCommand}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Main three-column editor -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="230" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="330" />
      </Grid.ColumnDefinitions>

      <!-- Left: add + layers -->
      <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
        <Grid Margin="10">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0">
            <TextBlock Text="DISPLAY" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Margin="4,2,0,7" />
            <TextBlock Text="Protocol" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="2,0,0,2" />
            <ComboBox ItemsSource="{Binding DisplayProtocolOptions}"
                      DisplayMemberPath="Label"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding DisplayProtocol}"
                      Margin="2,0,2,5"
                      ToolTip="Auto detects known USB35INCHIPSV2 Rev-A screens. Change only for firmware compatibility." />

            <TextBlock Text="Color mode" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="2,0,0,2" />
            <ComboBox ItemsSource="{Binding DisplayColorOptions}"
                      DisplayMemberPath="Label"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding DisplayColorMode}"
                      Margin="2,0,2,5"
                      ToolTip="RGB565 little-endian is standard for Rev-A. Use Color test to diagnose red/blue swaps or byte order." />

            <TextBlock Text="THEMES" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Margin="4,12,0,7" />
            <ComboBox ItemsSource="{Binding Themes}"
                      SelectedItem="{Binding SelectedTheme}"
                      DisplayMemberPath="DisplayName"
                      Margin="2,0,2,5"
                      ToolTip="Built-in themes and themes saved in Documents\PC Info Screen Studio\Themes" />
            <UniformGrid Columns="2">
              <Button Content="Load theme" Command="{Binding LoadThemeCommand}" />
              <Button Content="Refresh list" Command="{Binding RefreshThemesCommand}" />
            </UniformGrid>

            <TextBlock Text="ADD" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Margin="4,14,0,7" />
            <UniformGrid Columns="2">
              <Button Content="Text" Command="{Binding AddWidgetCommand}" CommandParameter="Text" />
              <Button Content="Value" Command="{Binding AddWidgetCommand}" CommandParameter="Value" />
              <Button Content="Circle" Command="{Binding AddWidgetCommand}" CommandParameter="CircularGauge" />
              <Button Content="Clock" Command="{Binding AddWidgetCommand}" CommandParameter="AnalogClock" ToolTip="Traditional analog clock" />
              <Button Content="Bar" Command="{Binding AddWidgetCommand}" CommandParameter="BarGauge" />
              <Button Content="Graph" Command="{Binding AddWidgetCommand}" CommandParameter="Graph" />
              <Button Content="Shape" Command="{Binding AddWidgetCommand}" CommandParameter="Shape" />
            </UniformGrid>

            <TextBlock Text="MEDIA" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Margin="4,14,0,7" />
            <UniformGrid Columns="2">
              <Button Content="Image" Command="{Binding ImportImageCommand}" />
              <Button Content="GIF" Command="{Binding ImportGifCommand}" />
              <Button Content="Video" Command="{Binding ImportVideoCommand}" />
              <Button Content="Font" Command="{Binding ImportFontCommand}" />
            </UniformGrid>
          </StackPanel>

          <Border Grid.Row="1" Height="1" Background="{StaticResource BorderBrush}" Margin="0,12" />

          <Grid Grid.Row="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="LAYERS" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Margin="4,0,0,7" />
            <ListBox Grid.Row="1" ItemsSource="{Binding Document.Widgets}" SelectedItem="{Binding SelectedWidget}" Background="#101318" BorderBrush="{StaticResource BorderBrush}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="3">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="26" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="30" />
                    </Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding IsVisible}" ToolTip="Visible" HorizontalAlignment="Center" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Type}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                    <CheckBox Grid.Column="2" IsChecked="{Binding IsLocked}" Content="L" ToolTip="Lock" HorizontalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <UniformGrid Grid.Row="2" Columns="4" Margin="0,6,0,0">
              <Button Content="Up" Command="{Binding MoveLayerUpCommand}" ToolTip="Move layer forward" />
              <Button Content="Down" Command="{Binding MoveLayerDownCommand}" ToolTip="Move layer backward" />
              <Button Content="Copy" Command="{Binding DuplicateWidgetCommand}" ToolTip="Duplicate" />
              <Button Content="Del" Command="{Binding DeleteWidgetCommand}" ToolTip="Delete" />
            </UniformGrid>
          </Grid>
        </Grid>
      </Border>

      <!-- Center: real pixel canvas -->
      <Grid Grid.Column="1" Background="#0B0D10">
        <Grid.RowDefinitions>
          <RowDefinition Height="42" />
          <RowDefinition Height="*" />
          <RowDefinition Height="32" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="12,7">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Column="0" VerticalAlignment="Center">
            <Run Text="Canvas  " Foreground="{StaticResource MutedTextBrush}" />
            <Run Text="{Binding Document.CanvasWidth}" /><Run Text=" × " /><Run Text="{Binding Document.CanvasHeight}" />
          </TextBlock>

          <TextBlock Grid.Column="1"
                     Text="Drag to move · drag handles to resize"
                     Foreground="{StaticResource MutedTextBrush}"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Center" />

          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <CheckBox Content="Grid" IsChecked="{Binding Document.EditorGridVisible}" Margin="4,0,8,0" />
            <CheckBox Content="Snap" IsChecked="{Binding Document.SnapToGrid}" Margin="0,0,8,0" />
            <TextBlock Text="Size" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBox Width="42" Text="{Binding Document.GridSize, UpdateSourceTrigger=LostFocus}" ToolTip="Grid spacing in screen pixels" />
          </StackPanel>
        </Grid>
        <Border Grid.Row="1" Margin="18" Padding="18" Background="#111419" BorderBrush="#252A32" BorderThickness="1" CornerRadius="8">
          <controls:DesignerSurface />
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
          <TextBlock Text="Use simulated values for design, or enable Live data for Windows CPU/RAM/disk/network/date/time metrics." Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
        </StackPanel>
      </Grid>

      <!-- Right: contextual properties -->
      <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">
            <TextBlock Text="PROPERTIES" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Margin="2,2,0,10" />

            <TextBlock Text="Select an item on the canvas or in Layers." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="2,20">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedWidget}" Value="{x:Null}">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>

            <ContentControl Content="{Binding SelectedWidget}">
              <ContentControl.ContentTemplate>
                <DataTemplate DataType="{x:Type models:WidgetModel}">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                      <TextBlock Text="{Binding Type}" FontSize="18" FontWeight="SemiBold" />
                      <CheckBox DockPanel.Dock="Right" Content="Lock" IsChecked="{Binding IsLocked}" VerticalAlignment="Center" />
                    </DockPanel>

                    <TextBlock Text="Name" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,8" />

                    <TextBlock Text="POSITION &amp; SIZE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Margin="0,10,0,6" />
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                      <TextBlock Grid.Row="0" Grid.Column="0" Text="X" VerticalAlignment="Center" Margin="0,0,5,0" />
                      <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding X, UpdateSourceTrigger=LostFocus}" Margin="0,2,8,2" />
                      <TextBlock Grid.Row="0" Grid.Column="2" Text="Y" VerticalAlignment="Center" Margin="0,0,5,0" />
                      <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding Y, UpdateSourceTrigger=LostFocus}" Margin="0,2,0,2" />
                      <TextBlock Grid.Row="1" Grid.Column="0" Text="W" VerticalAlignment="Center" Margin="0,0,5,0" />
                      <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Width, UpdateSourceTrigger=LostFocus}" Margin="0,2,8,2" />
                      <TextBlock Grid.Row="1" Grid.Column="2" Text="H" VerticalAlignment="Center" Margin="0,0,5,0" />
                      <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding Height, UpdateSourceTrigger=LostFocus}" Margin="0,2,0,2" />
                      <TextBlock Grid.Row="2" Grid.Column="0" Text="Rot" VerticalAlignment="Center" Margin="0,0,5,0" />
                      <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Rotation, UpdateSourceTrigger=LostFocus}" Margin="0,2,8,2" />
                      <TextBlock Grid.Row="2" Grid.Column="2" Text="Opacity" VerticalAlignment="Center" Margin="0,0,5,0" />
                      <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding Opacity, UpdateSourceTrigger=LostFocus}" Margin="0,2,0,2" />
                    </Grid>

                    <!-- Data controls -->
                    <StackPanel Margin="0,8,0,0">
                      <StackPanel.Style>
                        <Style TargetType="StackPanel">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:WidgetType.Text}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:WidgetType.Value}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:WidgetType.CircularGauge}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:WidgetType.BarGauge}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:WidgetType.Graph}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </StackPanel.Style>
                      <TextBlock Text="DATA" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,6" />
                      <TextBlock Text="Source" Foreground="{StaticResource MutedTextBrush}" />
                      <ComboBox ItemsSource="{Binding DataContext.DataSources, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding DataSource}" Margin="0,3,0,7" />

                      <StackPanel Margin="0,2,0,8">
                        <StackPanel.Style>
                          <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding DataSource}" Value="Weather.Temperature"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                              <DataTrigger Binding="{Binding DataSource}" Value="Weather.FeelsLike"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                              <DataTrigger Binding="{Binding DataSource}" Value="Weather.Humidity"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                              <DataTrigger Binding="{Binding DataSource}" Value="Weather.Wind"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                              <DataTrigger Binding="{Binding DataSource}" Value="Weather.WindDirection"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                              <DataTrigger Binding="{Binding DataSource}" Value="Weather.WindGust"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                              <DataTrigger Binding="{Binding DataSource}" Value="Weather.Condition"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                              <DataTrigger Binding="{Binding DataSource}" Value="Weather.Location"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                              <DataTrigger Binding="{Binding DataSource}" Value="Weather.Precipitation"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                              <DataTrigger Binding="{Binding DataSource}" Value="Weather.PrecipitationChance"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                              <DataTrigger Binding="{Binding DataSource}" Value="Weather.CloudCover"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                              <DataTrigger Binding="{Binding DataSource}" Value="Weather.Pressure"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                              <DataTrigger Binding="{Binding DataSource}" Value="Weather.DayNight"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                              <DataTrigger Binding="{Binding DataSource}" Value="Weather.TodayHigh"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                              <DataTrigger Binding="{Binding DataSource}" Value="Weather.TodayLow"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                              <DataTrigger Binding="{Binding DataSource}" Value="Weather.TodayCondition"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                              <DataTrigger Binding="{Binding DataSource}" Value="Weather.Sunrise"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                              <DataTrigger Binding="{Binding DataSource}" Value="Weather.Sunset"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </StackPanel.Style>

                        <TextBlock Text="Weather city" Foreground="{StaticResource MutedTextBrush}" />
                        <Grid Margin="0,3,0,2">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBox Text="{Binding DataContext.WeatherCity, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                                   ToolTip="City or City, Country, for example Düsseldorf, Germany" />
                          <Button Grid.Column="1"
                                  Content="Update"
                                  Command="{Binding DataContext.UpdateWeatherCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  Margin="6,0,0,0"
                                  Padding="9,4" />
                        </Grid>
                        <TextBlock Text="{Binding DataContext.WeatherStatus, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="10"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                      <TextBlock Text="Label" Foreground="{StaticResource MutedTextBrush}" />
                      <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,7" />
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="72" /></Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="Preview value" Foreground="{StaticResource MutedTextBrush}" />
                          <Slider Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding SimulatedValue}" />
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding SimulatedValue, UpdateSourceTrigger=LostFocus}" Margin="8,18,0,0" />
                      </Grid>
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,0"><TextBlock Text="Min" Foreground="{StaticResource MutedTextBrush}" /><TextBox Text="{Binding Minimum, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0"><TextBlock Text="Max" Foreground="{StaticResource MutedTextBrush}" /><TextBox Text="{Binding Maximum, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                        <StackPanel Grid.Column="2" Margin="5,0,0,0"><TextBlock Text="Suffix" Foreground="{StaticResource MutedTextBrush}" /><TextBox Text="{Binding Suffix, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                      </Grid>
                      <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <CheckBox Content="Label" IsChecked="{Binding ShowLabel}" Margin="0,0,14,0" />
                        <CheckBox Content="Value" IsChecked="{Binding ShowValue}" />
                      </StackPanel>
                    </StackPanel>

                    <!-- Typography -->
                    <StackPanel Margin="0,8,0,0">
                      <StackPanel.Style>
                        <Style TargetType="StackPanel">
                          <Setter Property="Visibility" Value="Visible" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:WidgetType.Image}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:WidgetType.AnimatedImage}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:WidgetType.Video}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:WidgetType.Shape}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:WidgetType.AnalogClock}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </StackPanel.Style>
                      <TextBlock Text="TYPOGRAPHY" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,6" />
                      <TextBlock Text="Font" Foreground="{StaticResource MutedTextBrush}" />
                      <ComboBox ItemsSource="{Binding DataContext.FontChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                IsEditable="True"
                                IsTextSearchEnabled="True"
                                Text="{Binding FontFamily, UpdateSourceTrigger=PropertyChanged}"
                                Margin="0,3,0,6"
                                ToolTip="Includes built-in Bungee, Fredoka, Monoton and Orbitron fonts. You can also type an installed Windows font name." />
                      <TextBlock Text="Embedded custom font" Foreground="{StaticResource MutedTextBrush}" />
                      <ComboBox ItemsSource="{Binding DataContext.FontAssets, RelativeSource={RelativeSource AncestorType=Window}}"
                                DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectedValue="{Binding FontAssetId}" Margin="0,3,0,6" />
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                          <StackPanel.Style>
                            <Style TargetType="StackPanel">
                              <Setter Property="Visibility" Value="Visible" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Type}" Value="{x:Static models:WidgetType.Text}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                <DataTrigger Binding="{Binding Type}" Value="{x:Static models:WidgetType.Value}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                <DataTrigger Binding="{Binding Type}" Value="{x:Static models:WidgetType.CircularGauge}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </StackPanel.Style>
                          <TextBlock Text="Size" Foreground="{StaticResource MutedTextBrush}" />
                          <TextBox Text="{Binding FontSize, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Content="Bold" IsChecked="{Binding FontBold}" Margin="12,18,5,0" />
                        <CheckBox Grid.Column="2" Content="Italic" IsChecked="{Binding FontItalic}" Margin="5,18,0,0" />
                      </Grid>
                    </StackPanel>

                    <!-- Graph -->
                    <StackPanel Margin="0,8,0,0">
                      <StackPanel.Style>
                        <Style TargetType="StackPanel">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers><DataTrigger Binding="{Binding Type}" Value="{x:Static models:WidgetType.Graph}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style>
                      </StackPanel.Style>
                      <TextBlock Text="GRAPH" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,6" />
                      <TextBlock Text="Style" Foreground="{StaticResource MutedTextBrush}" />
                      <ComboBox ItemsSource="{Binding DataContext.GraphStyles, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding GraphStyle}" Margin="0,3,0,6" />
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,5,0"><TextBlock Text="History (s)" Foreground="{StaticResource MutedTextBrush}" /><TextBox Text="{Binding HistorySeconds, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="Line width" Foreground="{StaticResource MutedTextBrush}" /><TextBox Text="{Binding LineThickness, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                      </Grid>
                      <StackPanel Orientation="Horizontal"><CheckBox Content="Grid" IsChecked="{Binding ShowGrid}" Margin="0,4,15,0" /><CheckBox Content="Auto scale" IsChecked="{Binding AutoScale}" Margin="0,4,0,0" /></StackPanel>
                    </StackPanel>

                    <!-- Gauge -->
                    <StackPanel Margin="0,8,0,0">
                      <StackPanel.Style>
                        <Style TargetType="StackPanel">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:WidgetType.CircularGauge}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:WidgetType.BarGauge}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </StackPanel.Style>
                      <TextBlock Text="GAUGE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,6" />
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,5,0"><TextBlock Text="Thickness" Foreground="{StaticResource MutedTextBrush}" /><TextBox Text="{Binding GaugeThickness, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="Segments" Foreground="{StaticResource MutedTextBrush}" /><TextBox Text="{Binding SegmentCount, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                      </Grid>
                    </StackPanel>

                    <!-- Media -->
                    <StackPanel Margin="0,8,0,0">
                      <StackPanel.Style>
                        <Style TargetType="StackPanel">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:WidgetType.Image}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:WidgetType.AnimatedImage}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:WidgetType.Video}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </StackPanel.Style>
                      <TextBlock Text="MEDIA" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,6" />
                      <TextBlock Text="Fit" Foreground="{StaticResource MutedTextBrush}" />
                      <ComboBox ItemsSource="{Binding DataContext.MediaFits, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding MediaFit}" Margin="0,3,0,5" />
                      <CheckBox Content="Loop" IsChecked="{Binding Loop}" />
                      <CheckBox Content="Automatic optimization" IsChecked="{Binding AutoOptimize}" />
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,5,0"><TextBlock Text="Speed" Foreground="{StaticResource MutedTextBrush}" /><TextBox Text="{Binding PlaybackSpeed, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="FPS (0=Auto)" Foreground="{StaticResource MutedTextBrush}" /><TextBox Text="{Binding TargetFps, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                      </Grid>
                    </StackPanel>

                    <!-- Shape -->
                    <StackPanel Margin="0,8,0,0">
                      <StackPanel.Style>
                        <Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Type}" Value="{x:Static models:WidgetType.Shape}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
                      </StackPanel.Style>
                      <TextBlock Text="SHAPE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,6" />
                      <ComboBox ItemsSource="{Binding DataContext.ShapeStyles, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding ShapeStyle}" />
                      <TextBlock Text="Corner radius" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0" />
                      <TextBox Text="{Binding CornerRadius, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>

                    <TextBlock Text="COLORS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Margin="0,16,0,6" />
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                      <StackPanel Margin="0,0,5,0"><TextBlock Text="Text" Foreground="{StaticResource MutedTextBrush}" /><controls:ColorPickerButton HexColor="{Binding ForegroundColor}" /></StackPanel>
                      <StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="Graph / accent" Foreground="{StaticResource MutedTextBrush}" /><controls:ColorPickerButton HexColor="{Binding AccentColor}" /></StackPanel>
                    </Grid>
                    <Grid Margin="0,5,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                      <StackPanel Margin="0,0,5,0"><TextBlock Text="Background" Foreground="{StaticResource MutedTextBrush}" /><controls:ColorPickerButton HexColor="{Binding BackgroundColor}" /></StackPanel>
                      <StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="Track / grid" Foreground="{StaticResource MutedTextBrush}" /><controls:ColorPickerButton HexColor="{Binding SecondaryColor}" /></StackPanel>
                    </Grid>
                  </StackPanel>
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- status -->
    <Border Grid.Row="2" Background="#0C0F13" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
      <DockPanel Margin="10,0">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
          <TextBlock Text="{Binding DeviceStatus}" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
          <TextBlock Text="   Sensors: " VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
          <TextBlock Text="{Binding HardwareStatus}" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" ToolTip="{Binding HardwareStatus}" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <TextBlock Text="Theme: " Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Document.Name}" VerticalAlignment="Center" />
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>
