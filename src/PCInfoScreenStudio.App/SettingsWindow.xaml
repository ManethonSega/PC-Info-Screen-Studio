<Window x:Class="PCInfoScreenStudio.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings · PC Info Screen Studio"
        Icon="{StaticResource AppIconImage}"
        Width="720" Height="760" MinWidth="620" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="22,16">
      <StackPanel>
        <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" />
        <TextBlock Text="Screen connection, runtime, sensors, and editor preferences." Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="22,16,22,22">
        <TextBlock Text="SCREEN &amp; CONNECTION" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,9" />
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="14">
          <StackPanel>
            <TextBlock Text="{Binding DeviceStatus}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <ComboBox ItemsSource="{Binding Ports}" DisplayMemberPath="DisplayName" SelectedValuePath="PortName" SelectedValue="{Binding SelectedPort}" ToolTip="Detected USB serial devices." />
            <UniformGrid Columns="3" Margin="0,5,0,8">
              <Button Content="Detect screen" Command="{Binding DetectScreenCommand}" />
              <Button Content="Refresh ports" Command="{Binding RefreshPortsCommand}" />
              <Button Content="{Binding DisplayActionLabel}" Command="{Binding ConnectCommand}" Style="{StaticResource PrimaryButtonStyle}" />
            </UniformGrid>

            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,6,0">
                <TextBlock Text="Theme orientation" Foreground="{StaticResource MutedTextBrush}" />
                <Button Command="{Binding ToggleOrientationCommand}" HorizontalContentAlignment="Left">
                  <StackPanel Orientation="Horizontal"><TextBlock Text="Current: " Foreground="{StaticResource MutedTextBrush}" /><TextBlock Text="{Binding Document.Orientation}" /></StackPanel>
                </Button>
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="6,0,0,0">
                <TextBlock Text="Physical screen rotation" Foreground="{StaticResource MutedTextBrush}" />
                <ComboBox ItemsSource="{Binding RotationOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Document.DeviceRotation}" Margin="2" />
              </StackPanel>
            </Grid>

            <TextBlock Text="USB protocol" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,2" />
            <ComboBox ItemsSource="{Binding DisplayProtocolOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding DisplayProtocol}" />
            <TextBlock Text="Display colour compatibility" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,2" />
            <ComboBox ItemsSource="{Binding DisplayColorOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding DisplayColorMode}" />
            <Button Content="Run display colour test" Command="{Binding TestScreenCommand}" HorizontalAlignment="Left" Margin="2,8,2,2" />
          </StackPanel>
        </Border>

        <TextBlock Text="RUNTIME" Style="{StaticResource SectionTitleStyle}" Margin="0,20,0,9" />
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="14">
          <StackPanel>
            <CheckBox Content="Use live sensor data" IsChecked="{Binding UseLiveData}" ToolTip="Use current computer values instead of preview values." />
            <CheckBox Content="Send editor changes immediately" IsChecked="{Binding LivePreview}" />
            <CheckBox Content="Start display automatically with the app" IsChecked="{Binding AutoStartDisplay}" />
            <CheckBox Content="Keep the lightweight runtime in the system tray" IsChecked="{Binding CloseToTray}" />
          </StackPanel>
        </Border>

        <TextBlock Text="HARDWARE SENSORS" Style="{StaticResource SectionTitleStyle}" Margin="0,20,0,9" />
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="14">
          <StackPanel>
            <TextBlock Text="{Binding HardwareStatus}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,7" />
            <CheckBox Content="Show advanced hardware sensors in data-source lists" IsChecked="{Binding ShowAdvancedSensors}" />
            <Button Content="Install or inspect full sensor access" Command="{Binding EnableFullSensorsCommand}" HorizontalAlignment="Left" Margin="2,7,2,2" />
          </StackPanel>
        </Border>

        <TextBlock Text="EDITOR" Style="{StaticResource SectionTitleStyle}" Margin="0,20,0,9" />
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="14">
          <StackPanel>
            <TextBlock Text="Canvas zoom" Foreground="{StaticResource MutedTextBrush}" />
            <Slider Minimum="0.5" Maximum="3" SmallChange="0.1" LargeChange="0.5" Value="{Binding CanvasZoom}" />
            <Button Content="Run setup assistant again" Command="{Binding ShowSetupAssistantCommand}" HorizontalAlignment="Left" Margin="2,8,2,2" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12">
      <Button Content="Close" IsDefault="True" Click="OnCloseClick" HorizontalAlignment="Right" Padding="22,7" />
    </Border>
  </Grid>
</Window>
