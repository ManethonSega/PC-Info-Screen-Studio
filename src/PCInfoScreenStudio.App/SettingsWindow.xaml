<Window x:Class="PCInfoScreenStudio.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Background="{StaticResource PageSurfaceBrush}"
        Foreground="{StaticResource PageTextBrush}"
        Title="Settings · PC Info Screen Studio"
        Icon="{StaticResource AppIconImage}"
        Width="720" Height="760" MinWidth="620" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <Grid Background="{StaticResource PageSurfaceBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="22,16">
      <StackPanel>
        <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource PageTextBrush}" />
        <TextBlock Text="Screen connection, runtime, sensors, and editor preferences." Foreground="{StaticResource PageMutedTextBrush}" Margin="0,3,0,0" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" Background="{StaticResource PageSurfaceBrush}" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="22,16,22,22">
        <TextBlock Text="SCREEN &amp; CONNECTION" Style="{StaticResource PageSectionTitleStyle}" Margin="0,0,0,9" />
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="14">
          <StackPanel>
            <TextBlock Text="{Binding DeviceStatus}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <ComboBox ItemsSource="{Binding Ports}" DisplayMemberPath="DisplayName" SelectedValuePath="PortName" SelectedValue="{Binding SelectedPort}" ToolTip="Detected USB serial devices." />
            <UniformGrid Columns="3" Margin="0,5,0,8">
              <Button Content="Detect screen" Command="{Binding DetectScreenCommand}" ToolTip="Find a likely compatible USB serial screen. You can choose the port above if detection is uncertain." />
              <Button Content="Refresh ports" Command="{Binding RefreshPortsCommand}" ToolTip="Refresh the USB serial device list after plugging in or reconnecting your screen." />
              <Button Content="{Binding DisplayActionLabel}" Command="{Binding ConnectCommand}" Style="{StaticResource PrimaryButtonStyle}" ToolTip="{Binding DisplayActionToolTip}" />
            </UniformGrid>

            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,6,0">
                <TextBlock Text="Theme orientation" Foreground="{StaticResource MutedTextBrush}" />
                <Button Command="{Binding ToggleOrientationCommand}" HorizontalContentAlignment="Left">
                  <StackPanel Orientation="Horizontal"><TextBlock Text="Current: " Foreground="{StaticResource MutedTextBrush}" /><TextBlock Text="{Binding Document.Orientation}" /></StackPanel>
                </Button>
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="6,0,0,0">
                <TextBlock Text="Physical screen rotation" Foreground="{StaticResource MutedTextBrush}" />
                <ComboBox ItemsSource="{Binding RotationOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Document.DeviceRotation}" Margin="2" ToolTip="Rotate the physical display output without rotating individual widgets." />
              </StackPanel>
            </Grid>

            <TextBlock Text="USB protocol" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,2" />
            <ComboBox ItemsSource="{Binding DisplayProtocolOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding DisplayProtocol}" ToolTip="Leave on Auto unless your confirmed screen requires another USB protocol." />
            <TextBlock Text="Display colour compatibility" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,2" />
            <ComboBox ItemsSource="{Binding DisplayColorOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding DisplayColorMode}" ToolTip="Leave on Auto. Change only if colours on the physical screen differ from the preview." />
            <Button Content="Run display colour test" Command="{Binding TestScreenCommand}" HorizontalAlignment="Left" Margin="2,8,2,2" ToolTip="Send test colours to the connected screen to diagnose colour or rotation problems." />
          </StackPanel>
        </Border>

        <TextBlock Text="RUNTIME" Style="{StaticResource PageSectionTitleStyle}" Margin="0,20,0,9" />
        <Border x:Name="RuntimePanel" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="14">
          <StackPanel>
            <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}" IsEnabled="{Binding CanChangeWindowsStartup}"
                      ToolTip="Start in the tray when you sign in. One-time Windows approval registers the startup task with full sensor access." />
            <TextBlock Text="{Binding WindowsStartupStatus}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" FontSize="11" Margin="3,3,3,8" />
            <TextBlock Text="Your last mode, themes, layers and photo folders reopen automatically." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" FontSize="11" Margin="3,0,3,8" />
            <CheckBox IsChecked="{Binding UseLiveData, Mode=OneWay}" IsEnabled="False"
                      ToolTipService.ShowOnDisabled="True" ToolTip="Live sensor data is always enabled. Sensor availability depends on your hardware and access permissions.">
              <TextBlock Text="Use live sensor data" Foreground="{StaticResource PageMutedTextBrush}" />
            </CheckBox>
            <CheckBox Content="Send live updates to the connected screen" IsChecked="{Binding LivePreview}" ToolTip="Keep the connected screen up to date with readings, photos and editor changes." />
            <CheckBox Content="Start display automatically with the app" IsChecked="{Binding AutoStartDisplay}" ToolTip="Restore your workspace, identify the last screen even if its COM number changes, and keep retrying quietly until the USB display is ready." />
            <CheckBox Content="Clear the screen when the app exits" IsChecked="{Binding ClearDisplayOnExit}" ToolTip="Show a black screen when you deliberately exit the app. Windows may already have stopped USB access during shutdown, so this is best-effort." />
            <CheckBox Content="Keep running in the tray when closed" IsChecked="{Binding CloseToTray}" ToolTip="Closing the window keeps display output running. Use Exit in the tray menu to save the session and stop the app." />
          </StackPanel>
        </Border>

        <TextBlock Text="HARDWARE SENSORS" Style="{StaticResource PageSectionTitleStyle}" Margin="0,20,0,9" />
        <Border x:Name="HardwareSensorsPanel" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="14">
          <StackPanel>
            <TextBlock Text="{Binding HardwareStatus}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,7" />
            <CheckBox Content="Request administrator access when the app starts" IsChecked="{Binding RequestAdministratorAtStartup}"
                      ToolTip="When PawnIO is installed, request Windows administrator permission on launch for full sensors. Takes effect next time you open the app." />
            <TextBlock Text="Full hardware sensors may need administrator access. When Windows startup is enabled, its approved task supplies this access at sign-in. Opening the app manually may still request approval. If you decline, available sensors still work."
                       Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" FontSize="11" Margin="3,3,3,8" />
            <CheckBox Content="Show advanced hardware sensors in data-source lists" IsChecked="{Binding ShowAdvancedSensors}" ToolTip="Include raw hardware sensor entries. Keep this off for a simpler source list." />
            <Button Content="Install or inspect full sensor access" Command="{Binding EnableFullSensorsCommand}" HorizontalAlignment="Left" Margin="2,7,2,2" ToolTip="Check full sensor access or install the bundled PawnIO prerequisite after confirmation." />
          </StackPanel>
        </Border>

        <TextBlock Text="EDITOR" Style="{StaticResource PageSectionTitleStyle}" Margin="0,20,0,9" />
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="14">
          <StackPanel>
            <TextBlock Text="Canvas zoom" Foreground="{StaticResource MutedTextBrush}" />
            <Slider Minimum="0.5" Maximum="3" SmallChange="0.1" LargeChange="0.5" Value="{Binding CanvasZoom}" ToolTip="Change editor magnification. The physical screen resolution stays unchanged." />
            <Button Content="Run setup assistant again" Command="{Binding ShowSetupAssistantCommand}" HorizontalAlignment="Left" Margin="2,8,2,2" ToolTip="Reopen the guided screen connection and starter-theme assistant." />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12">
      <Button Content="Close" IsDefault="True" Click="OnCloseClick" HorizontalAlignment="Right" Padding="22,7" />
    </Border>
  </Grid>
</Window>
